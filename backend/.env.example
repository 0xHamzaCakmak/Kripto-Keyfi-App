NODE_ENV=development
PORT=4000
DATABASE_URL="mysql://root:root@127.0.0.1:3306/kriptokeyfi"
FRONTEND_URL="http://localhost:3000"
JWT_ACCESS_SECRET="replace-with-a-random-secret-at-least-32-characters"
JWT_REFRESH_SECRET="replace-with-a-different-random-secret-at-least-32-characters"
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
INITIAL_ADMIN_EMAIL="admin@example.com"
INITIAL_ADMIN_PASSWORD="replace-with-a-strong-admin-password"
INITIAL_ADMIN_NAME="KriptoKeyfi Admin"
GOOGLE_CLIENT_ID="your-google-web-client-id.apps.googleusercontent.com"
TRADING_CREDENTIALS_MASTER_KEY="generate-a-random-32-byte-hexadecimal-key"
TRADING_ENGINE_SHADOW_COMPARE_ENABLED=false
TRADING_ENGINE_EXECUTION_ENABLED=false
TRADING_ENGINE_URL="http://127.0.0.1:8081"
TRADING_ENGINE_TOKEN=""
