# PUBLIC TEMPLATE ONLY. Never write real secrets into this file.
# Copy it to backend/.env.production.local for local secret storage;
# .env.production.local is ignored by Git.

# ============================================================
# 1. BACKEND / PRODUCTION RUNTIME
# ============================================================
NODE_ENV=production
PORT=4002
DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3306/DATABASE"
FRONTEND_URL="https://kriptokeyfi.com"

# ============================================================
# 2. AUTHENTICATION, COOKIES AND INITIAL ADMIN
# ============================================================
JWT_ACCESS_SECRET="REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS"
JWT_REFRESH_SECRET="REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_CHARACTERS"
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
INITIAL_ADMIN_EMAIL="admin@example.com"
INITIAL_ADMIN_PASSWORD="REPLACE_WITH_STRONG_ADMIN_PASSWORD"
INITIAL_ADMIN_NAME="KriptoKeyfi Admin"
GOOGLE_CLIENT_ID=""

# ============================================================
# 3. SHARED TRADING SECRETS
# Keep the existing production master key. Changing it requires
# re-encrypting every stored exchange credential.
# The same TRADING_ENGINE_TOKEN is used by backend and Go Engine.
# ============================================================
TRADING_CREDENTIALS_MASTER_KEY="REPLACE_WITH_EXISTING_64_HEX_MASTER_KEY"
TRADING_ENGINE_TOKEN="REPLACE_WITH_RANDOM_TOKEN_AT_LEAST_32_CHARACTERS"
TRADING_ENGINE_URL="http://127.0.0.1:8081"

# ============================================================
# 4. BACKEND TRADING FEATURE FLAGS
# These flags permit PAPER and Binance TESTNET only. The autonomous
# domain still keeps production real-money LIVE unavailable.
# ============================================================
TRADING_ENGINE_SHADOW_COMPARE_ENABLED=false
TRADING_ENGINE_EXECUTION_ENABLED=true
AUTONOMOUS_TESTNET_EXECUTION_ENABLED=true

# ============================================================
# 5. GO TRADING ENGINE
# ============================================================
TRADING_ENGINE_MODE=cutover
TRADING_ENGINE_ADDR=127.0.0.1:8081
TRADING_ENGINE_SHADOW_READ_ENABLED=true
TRADING_ENGINE_REALTIME_ENABLED=false
TRADING_ENGINE_BOT_SCHEDULER_ENABLED=true
TRADING_ENGINE_BOT_WORKERS=8
TRADING_ENGINE_BOT_POLL_INTERVAL=250ms
TRADING_ENGINE_AUTONOMOUS_TESTNET_ENABLED=true
TRADING_ENGINE_LIQUIDATION_STREAM_ENABLED=true
TRADING_ENGINE_LIQUIDATION_STREAM_URL="wss://fstream.binance.com/ws/!forceOrder@arr"
TRADING_ENGINE_LOG_LEVEL=info
TRADING_ENGINE_SHUTDOWN_TIMEOUT=10s

# Comparison-only observer. It cannot execute orders. Leave disabled
# unless an approved internal inference gateway has been configured.
TRADING_ENGINE_AI_OBSERVER_ENABLED=false
TRADING_ENGINE_AI_OBSERVER_URL=""
TRADING_ENGINE_AI_OBSERVER_TOKEN=""
TRADING_ENGINE_AI_OBSERVER_PROVIDER=HTTP_GATEWAY
TRADING_ENGINE_AI_OBSERVER_MODEL=""
TRADING_ENGINE_AI_OBSERVER_PROMPT_VERSION=v1
TRADING_ENGINE_AI_OBSERVER_TIMEOUT=1500ms

# ============================================================
# 6. AUTONOMOUS EVOLUTION / LEARNING
# ============================================================
AI_TRADING_EVOLUTION_ENABLED=true
AI_TRADING_EVOLUTION_INTERVAL_MINUTES=2
AI_TRADING_EVOLUTION_MIN_TRADES=50
AI_TRADING_UNIVERSE_ENABLED=true
AI_TRADING_UNIVERSE_INTERVAL_MINUTES=5
AI_TRADING_LEARNING_ENABLED=true
AI_TRADING_LEARNING_INTERVAL_MINUTES=5
AI_TRADING_LEARNING_MIN_NEW_TRADES=25
COINGECKO_API_KEY=""
COINGECKO_API_BASE_URL="https://api.coingecko.com/api/v3"
COINMARKETCAP_API_KEY=""
COINMARKETCAP_API_BASE_URL="https://pro-api.coinmarketcap.com/v1"
AI_TRADING_MAX_GENERATIONS=20

# ============================================================
# 7. NEWS PIPELINE AND AI PROVIDERS
# ============================================================
NEWS_AI_PROVIDER=multi
NEWS_AI_PROVIDER_ORDER="groq,deepseek"
NEWS_AI_ENABLED=true
NEWS_AI_AUTO_PROCESS=true
NEWS_AI_AUTO_PUBLISH_ENABLED=true
NEWS_SYNC_ENABLED=true
NEWS_AI_MAX_CONCURRENCY=2
NEWS_AI_BATCH_SIZE=24
NEWS_IMAGE_RETRY_BATCH_SIZE=12
NEWS_EXTERNAL_RETENTION_LIMIT=0

GROQ_API_KEY=""
GROQ_API_BASE_URL="https://api.groq.com/openai/v1"
GROQ_PRIMARY_MODEL="openai/gpt-oss-20b"
GROQ_FALLBACK_MODEL="openai/gpt-oss-120b"

DEEPSEEK_API_KEY=""
DEEPSEEK_API_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-v4-flash"

# ============================================================
# 8. R2 MEDIA STORAGE (all fields are required in production)
# ============================================================
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL="https://media.kriptokeyfi.com"

# ============================================================
# 9. MARKET / SOCIAL DATA SOURCES
# ============================================================
SORSA_API_KEY=""
SORSA_API_BASE_URL="https://api.sorsa.io/v3"
X_API_BEARER_TOKEN=""
X_API_BASE_URL="https://api.x.com/2"
OKX_ONCHAIN_API_KEY=""
OKX_ONCHAIN_SECRET_KEY=""
OKX_ONCHAIN_PASSPHRASE=""
OKX_ONCHAIN_API_BASE_URL="https://web3.okx.com"

# ============================================================
# 10. YOUTUBE
# ============================================================
YOUTUBE_API_KEY=""
YOUTUBE_SYNC_ENABLED=true
YOUTUBE_SYNC_INTERVAL_MINUTES=45
YOUTUBE_INITIAL_SYNC_LIMIT=20
YOUTUBE_METRICS_ENABLED=true
YOUTUBE_METRICS_INTERVAL_HOURS=24

# ============================================================
# 11. ANALYTICS
# Configure all four Umami fields together or leave all four empty.
# ============================================================
UMAMI_API_URL=""
UMAMI_WEBSITE_ID=""
UMAMI_USERNAME=""
UMAMI_PASSWORD=""
GA4_DASHBOARD_URL="https://analytics.google.com/analytics/web/"
