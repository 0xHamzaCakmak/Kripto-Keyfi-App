generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  USER
}

enum UserStatus {
  ACTIVE
  PENDING
  PASSIVE
  SUSPENDED
  DELETED
}

enum UserCapabilityType {
  CREATOR
  AUTHOR
  PROJECT_OWNER
  DEVELOPER
}

enum UserCapabilityStatus {
  NOT_APPLIED
  PENDING
  APPROVED
  REJECTED
}

enum AuthProvider {
  GOOGLE
}

enum ExchangeProvider {
  BINANCE
  BYBIT
}

enum ExchangeEnvironment {
  TESTNET
  DEMO
}

enum ExchangeAccountType {
  USDT_M
  UNIFIED
}

enum ExchangeConnectionStatus {
  CONNECTED
  DEGRADED
  ERROR
  DISABLED
}

enum TradingExecutionEngine {
  TYPESCRIPT
  GO
}

enum TradingOrderSide {
  BUY
  SELL
}

enum TradingOrderType {
  MARKET
  LIMIT
  STOP_MARKET
  STOP_LIMIT
}

enum TradingMarginMode {
  ISOLATED
  CROSS
}

enum TradingOrderStatus {
  PENDING
  SUBMITTING
  OPEN
  PARTIALLY_FILLED
  FILLED
  CANCELING
  CANCELED
  CLOSING
  FAILED
  RECONCILIATION_REQUIRED
}

enum TradingOrderSource {
  MANUAL
  SCALPING_BOT
  GRID_BOT
  SYSTEM
  RISK_ENGINE
}

enum TradingRiskDecision {
  APPROVED
  REJECTED
  RISK_BLOCKED
  SYSTEM_BLOCKED
}

enum TradingBotType {
  SCALPING
  GRID
}

enum TradingBotMode {
  SHADOW
  PAPER
  DEMO
}

enum TradingBotState {
  DRAFT
  VALIDATING
  STARTING
  RUNNING
  PAUSED
  STOPPED
  RISK_BLOCKED
  RECONCILING
  EMERGENCY_STOPPED
  ERROR
}

enum TradingBotDesiredState {
  RUNNING
  PAUSED
  STOPPED
}

enum TradingBotDecisionKind {
  WARMING_UP
  HOLD
  BUY
  SELL
  GRID_BUY
  GRID_SELL
  OUT_OF_RANGE
}

enum TradingBotPaperSide {
  BUY
  SELL
}

enum TradingBotSignalSource {
  RULE_ENGINE
  AI_MODEL
}

enum TradingBotSignalAction {
  HOLD
  BUY
  SELL
}

enum TradingBotSignalStatus {
  OBSERVED
  ACCEPTED
  REJECTED
  EXPIRED
}

enum NewsIntegrationType {
  RSS
  API
}

enum NewsPublicationStatus {
  PENDING
  PUBLISHED
  ARCHIVED
  REJECTED
}

enum NewsAiStatus {
  WAITING
  PROCESSING
  READY
  REVIEW_REQUIRED
  FAILED
}

enum NewsAnalyticsEventType {
  NEWS_SUMMARY_VIEW
  NEWS_SOURCE_CLICK
  RELATED_NEWS_CLICK
  CATEGORY_CLICK
  WEB_VITAL
}

enum NewsRelationType {
  RELATED
  ACADEMY
  VIDEO
}

enum YoutubeChannelStatus {
  ACTIVE @map("active")
  PAUSED @map("paused")
}

enum VideoSource {
  ADMIN_MANUAL     @map("admin_manual")
  CREATOR_AUTO     @map("creator_auto")
  KRIPTOKEYFI_AUTO @map("kriptokeyfi_auto")
}

enum VideoStatus {
  PUBLISHED @map("published")
  HIDDEN    @map("hidden")
}

enum KOLPlatform {
  X
  YOUTUBE
  TELEGRAM
  DISCORD
  OTHER
}

enum KOLDataSourceType {
  VERIFIED_CAMPAIGN
  PLATFORM_API
  ADMIN_MANUAL
  INFLUENCER_REPORTED
  COMPANY_REPORTED
  ESTIMATED
  THIRD_PARTY
}

enum KOLConfidenceLevel {
  LOW
  MEDIUM
  HIGH
}

enum KOLPredictionDirection {
  BULLISH
  BEARISH
  NEUTRAL
}

enum KOLPredictionResult {
  PENDING
  CORRECT
  PARTIALLY_CORRECT
  INCORRECT
  EXPIRED
  INVALID
}

enum KOLRiskEventType {
  SCAM_PROMOTION
  RUG_PROMOTION
  MISLEADING_CLAIM
  UNDISCLOSED_AD
  DELETED_PROMOTION
  FAKE_ENGAGEMENT
  SUSPICIOUS_GROWTH
  COMMUNITY_COMPLAINT
  CONFLICT_OF_INTEREST
  OTHER
}

enum KOLRiskSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum KOLVisibility {
  INTERNAL
  PUBLIC
}

enum CompanyMemberRole {
  OWNER
  MANAGER
  ANALYST
}

enum CampaignStatus {
  DRAFT
  PLANNED
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum CampaignInfluencerStatus {
  INVITED
  ACCEPTED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum CampaignEventType {
  IMPRESSION
  CLICK
  REGISTRATION
  EMAIL_VERIFIED
  KYC
  DEPOSIT
  TRADE
  WALLET_CONNECT
  PURCHASE
  SUBSCRIPTION
  CUSTOM_CONVERSION
}

model User {
  id                   String               @id @default(cuid())
  email                String               @unique
  passwordHash         String?
  name                 String?
  username             String               @unique @db.VarChar(30)
  avatarUrl            String?              @db.VarChar(500)
  bio                  String?              @db.VarChar(500)
  emailVerifiedAt      DateTime?
  termsAcceptedAt      DateTime?
  privacyAcceptedAt    DateTime?
  role                 UserRole             @default(USER)
  status               UserStatus           @default(ACTIVE)
  mustChangePassword   Boolean              @default(false)
  profileCompleted     Boolean              @default(false)
  onboardingCompleted  Boolean              @default(false)
  lastLoginAt          DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  refreshSessions      RefreshSession[]
  exchangeAccounts     ExchangeAccount[]
  manualOrderPreviews  ManualOrderPreview[]
  tradingOrders        TradingOrder[]
  tradingAuditLogs     TradingAuditLog[]
  tradingOutboxEvents  TradingOutboxEvent[]
  tradingRiskProfiles  TradingRiskProfile[]
  tradingRiskEvents    TradingRiskEvent[]
  tradingBots          TradingBot[]
  tradingBotDecisions  TradingBotDecision[]
  tradingBotSignals    TradingBotSignal[]
  identities           UserIdentity[]
  profileRoles         UserProfileRole[]
  capabilities         UserCapability[]
  savedNews            NewsSavedArticle[]
  companyMemberships   CompanyMember[]
  kolProfile           KOL?                 @relation("kol_user")
  kolAuditLogs         KOLAuditLog[]        @relation("kol_audit_actor")
  addedYoutubeChannels YoutubeChannel[]     @relation("youtube_channel_added_by")
  addedVideos          Video[]              @relation("video_added_by")

  @@map("users")
}

model YoutubeChannel {
  id                Int                  @id @default(autoincrement())
  channelId         String               @unique @map("channel_id") @db.VarChar(64)
  uploadsPlaylistId String               @map("uploads_playlist_id") @db.VarChar(64)
  channelName       String?              @map("channel_name") @db.VarChar(255)
  channelUrl        String?              @map("channel_url") @db.VarChar(500)
  avatarUrl         String?              @map("avatar_url") @db.VarChar(500)
  isOwnChannel      Boolean              @default(false) @map("is_own_channel")
  status            YoutubeChannelStatus @default(ACTIVE)
  lastSyncedAt      DateTime?            @map("last_synced_at")
  addedById         String?              @map("added_by")
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")
  addedBy           User?                @relation("youtube_channel_added_by", fields: [addedById], references: [id], onDelete: SetNull)
  videos            Video[]

  @@index([status])
  @@index([addedById])
  @@map("youtube_channels")
}

model Video {
  id             Int             @id @default(autoincrement())
  youtubeVideoId String          @unique @map("youtube_video_id") @db.VarChar(32)
  youtubeUrl     String          @map("youtube_url") @db.VarChar(500)
  channelId      Int?            @map("channel_id")
  channelName    String?         @map("channel_name") @db.VarChar(255)
  title          String?         @db.VarChar(500)
  description    String?         @db.Text
  thumbnailUrl   String?         @map("thumbnail_url") @db.VarChar(500)
  duration       String?         @db.VarChar(16)
  publishedAt    DateTime?       @map("published_at")
  source         VideoSource
  status         VideoStatus     @default(PUBLISHED)
  addedById      String?         @map("added_by")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  channel        YoutubeChannel? @relation(fields: [channelId], references: [id], onDelete: SetNull)
  addedBy        User?           @relation("video_added_by", fields: [addedById], references: [id], onDelete: SetNull)

  @@index([channelId])
  @@index([status, publishedAt])
  @@index([source, status])
  @@index([addedById])
  @@map("videos")
}

model KOL {
  id                  String               @id @default(cuid())
  userId              String?              @unique
  slug                String               @unique @db.VarChar(100)
  displayName         String               @db.VarChar(160)
  username            String               @db.VarChar(100)
  avatarUrl           String?              @db.VarChar(700)
  country             String               @db.VarChar(80)
  language            String               @db.VarChar(16)
  bio                 String?              @db.Text
  isVerified          Boolean              @default(false)
  isDemo              Boolean              @default(false)
  isPublished         Boolean              @default(false)
  categories          Json
  useCaseScores       Json?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  user                User?                @relation("kol_user", fields: [userId], references: [id], onDelete: SetNull)
  socialAccounts      KOLSocialAccount[]
  scores              KOLScore[]
  predictions         KOLPrediction[]
  riskEvents          KOLRiskEvent[]
  audienceMetrics     KOLAudienceMetric[]
  campaignInfluencers CampaignInfluencer[]

  @@index([isPublished, isVerified])
  @@index([country, language])
  @@map("kols")
}

model KOLSocialAccount {
  id                String             @id @default(cuid())
  kolId             String
  platform          KOLPlatform
  platformUserId    String?            @db.VarChar(64)
  handle            String             @db.VarChar(160)
  profileUrl        String?            @db.VarChar(700)
  followerCount     BigInt             @default(0)
  followingCount    BigInt             @default(0)
  contentCount      BigInt             @default(0)
  listedCount       BigInt             @default(0)
  platformVerified  Boolean            @default(false)
  platformCreatedAt DateTime?
  engagementRate    Decimal?           @db.Decimal(8, 4)
  accountAgeDays    Int?
  sourceType        KOLDataSourceType
  verified          Boolean            @default(false)
  verificationDate  DateTime?
  confidence        KOLConfidenceLevel @default(LOW)
  sourceReference   String?            @db.VarChar(700)
  measuredAt        DateTime
  kol               KOL                @relation(fields: [kolId], references: [id], onDelete: Cascade)

  @@unique([kolId, platform, handle])
  @@unique([platform, platformUserId])
  @@index([platform, followerCount])
  @@map("kol_social_accounts")
}

model KOLScore {
  id                  String             @id @default(cuid())
  kolId               String
  overall             Decimal            @db.Decimal(5, 2)
  trust               Decimal            @db.Decimal(5, 2)
  audienceQuality     Decimal            @db.Decimal(5, 2)
  engagementQuality   Decimal            @db.Decimal(5, 2)
  marketKnowledge     Decimal            @db.Decimal(5, 2)
  predictionAccuracy  Decimal            @db.Decimal(5, 2)
  campaignPerformance Decimal            @db.Decimal(5, 2)
  transparency        Decimal            @db.Decimal(5, 2)
  risk                Decimal            @db.Decimal(5, 2)
  confidence          KOLConfidenceLevel
  sampleSize          Int                @default(0)
  verifiedDataRatio   Decimal            @db.Decimal(5, 4)
  methodologyVersion  String             @db.VarChar(40)
  calculatedAt        DateTime           @default(now())
  kol                 KOL                @relation(fields: [kolId], references: [id], onDelete: Cascade)

  @@index([kolId, calculatedAt])
  @@index([overall, confidence])
  @@map("kol_scores")
}

model KOLPrediction {
  id                String                 @id @default(cuid())
  kolId             String
  assetSymbol       String                 @db.VarChar(30)
  platform          KOLPlatform
  sourceUrl         String                 @db.VarChar(700)
  sourceContent     String                 @db.Text
  sourceContentHash String?                @db.VarChar(64)
  sourceSnapshotRef String?                @db.VarChar(700)
  publishedAt       DateTime
  capturedAt        DateTime               @default(now())
  direction         KOLPredictionDirection
  referencePrice    Decimal                @db.Decimal(36, 18)
  targetPrice       Decimal?               @db.Decimal(36, 18)
  invalidationPrice Decimal?               @db.Decimal(36, 18)
  timeHorizonDays   Int
  confidence        Decimal?               @db.Decimal(5, 2)
  evaluationDate    DateTime?
  result            KOLPredictionResult    @default(PENDING)
  evaluationNotes   String?                @db.Text
  evaluatedByUserId String?
  kol               KOL                    @relation(fields: [kolId], references: [id], onDelete: Cascade)

  @@index([kolId, publishedAt])
  @@index([result, evaluationDate])
  @@map("kol_predictions")
}

model KOLRiskEvent {
  id          String           @id @default(cuid())
  kolId       String
  type        KOLRiskEventType
  severity    KOLRiskSeverity
  title       String           @db.VarChar(220)
  description String           @db.Text
  evidenceUrl String?          @db.VarChar(700)
  verified    Boolean          @default(false)
  visibility  KOLVisibility    @default(INTERNAL)
  occurredAt  DateTime
  adminNotes  String?          @db.Text
  createdAt   DateTime         @default(now())
  kol         KOL              @relation(fields: [kolId], references: [id], onDelete: Cascade)

  @@index([kolId, visibility, occurredAt])
  @@index([type, severity])
  @@map("kol_risk_events")
}

model KOLAudienceMetric {
  id                     String             @id @default(cuid())
  kolId                  String
  platform               KOLPlatform
  totalFollowers         BigInt
  estimatedRealAudience  BigInt?
  estimatedBotPercentage Decimal?           @db.Decimal(5, 2)
  engagementRate         Decimal?           @db.Decimal(8, 4)
  averageViews           BigInt?
  averageComments        Int?
  averageShares          Int?
  averageLikes           Int?
  suspiciousGrowth       Boolean            @default(false)
  distribution           Json?
  sourceType             KOLDataSourceType
  verified               Boolean            @default(false)
  confidence             KOLConfidenceLevel @default(LOW)
  sourceReference        String?            @db.VarChar(700)
  measuredAt             DateTime
  kol                    KOL                @relation(fields: [kolId], references: [id], onDelete: Cascade)

  @@index([kolId, platform, measuredAt])
  @@map("kol_audience_metrics")
}

model Company {
  id        String          @id @default(cuid())
  name      String          @db.VarChar(180)
  website   String?         @db.VarChar(500)
  sector    String?         @db.VarChar(100)
  country   String          @db.VarChar(80)
  verified  Boolean         @default(false)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  members   CompanyMember[]
  campaigns Campaign[]

  @@map("companies")
}

model CompanyMember {
  companyId String
  userId    String
  role      CompanyMemberRole @default(ANALYST)
  company   Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([companyId, userId])
  @@index([userId])
  @@map("company_members")
}

model Campaign {
  id               String                 @id @default(cuid())
  companyId        String
  name             String                 @db.VarChar(180)
  project          String                 @db.VarChar(180)
  description      String?                @db.Text
  goal             String                 @db.VarChar(80)
  budget           Decimal                @db.Decimal(18, 2)
  currency         String                 @db.VarChar(12)
  countryTargets   Json
  languageTargets  Json
  audienceTargets  Json?
  categories       Json
  startDate        DateTime
  endDate          DateTime
  status           CampaignStatus         @default(DRAFT)
  kpi              String                 @db.VarChar(80)
  conversionTarget Int?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  company          Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  influencers      CampaignInfluencer[]
  trackingLinks    CampaignTrackingLink[]
  events           CampaignEvent[]

  @@index([companyId, status])
  @@map("campaigns")
}

model CampaignInfluencer {
  id             String                   @id @default(cuid())
  campaignId     String
  kolId          String
  agreedPrice    Decimal                  @db.Decimal(18, 2)
  currency       String                   @db.VarChar(12)
  deliverable    String                   @db.VarChar(120)
  status         CampaignInfluencerStatus @default(INVITED)
  startDate      DateTime?
  completionDate DateTime?
  notes          String?                  @db.Text
  campaign       Campaign                 @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  kol            KOL                      @relation(fields: [kolId], references: [id], onDelete: Restrict)
  trackingLinks  CampaignTrackingLink[]

  @@unique([campaignId, kolId])
  @@index([kolId, status])
  @@map("campaign_influencers")
}

model CampaignTrackingLink {
  id                   String             @id @default(cuid())
  campaignId           String
  campaignInfluencerId String
  code                 String             @unique @db.VarChar(80)
  destinationUrl       String             @db.VarChar(900)
  isActive             Boolean            @default(true)
  createdAt            DateTime           @default(now())
  campaign             Campaign           @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignInfluencer   CampaignInfluencer @relation(fields: [campaignInfluencerId], references: [id], onDelete: Cascade)
  events               CampaignEvent[]

  @@index([campaignId, campaignInfluencerId])
  @@map("campaign_tracking_links")
}

model CampaignEvent {
  id                BigInt               @id @default(autoincrement()) @db.UnsignedBigInt
  campaignId        String
  trackingLinkId    String
  eventType         CampaignEventType
  attributionIdHash String?              @db.VarChar(64)
  idempotencyKey    String               @unique @db.VarChar(191)
  value             Decimal?             @db.Decimal(18, 2)
  currency          String?              @db.VarChar(12)
  source            String               @db.VarChar(80)
  metadata          Json?
  occurredAt        DateTime
  createdAt         DateTime             @default(now())
  campaign          Campaign             @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  trackingLink      CampaignTrackingLink @relation(fields: [trackingLinkId], references: [id], onDelete: Cascade)

  @@index([campaignId, eventType, occurredAt])
  @@index([trackingLinkId, occurredAt])
  @@map("campaign_events")
}

model KOLAuditLog {
  id         String   @id @default(cuid())
  actorId    String
  action     String   @db.VarChar(100)
  entityType String   @db.VarChar(80)
  entityId   String   @db.VarChar(120)
  beforeData Json?
  afterData  Json?
  createdAt  DateTime @default(now())
  actor      User     @relation("kol_audit_actor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
  @@map("kol_audit_logs")
}

model NewsSource {
  id                   String              @id @default(cuid())
  name                 String              @db.VarChar(120)
  slug                 String              @unique @db.VarChar(80)
  websiteUrl           String              @db.VarChar(500)
  feedUrl              String?             @db.VarChar(500)
  apiConfig            Json?
  integrationType      NewsIntegrationType
  language             String              @default("tr") @db.VarChar(12)
  category             String?             @db.VarChar(80)
  logoUrl              String?             @db.VarChar(500)
  isActive             Boolean             @default(false)
  isTrusted            Boolean             @default(false)
  autoPublish          Boolean             @default(false)
  aiEnabled            Boolean             @default(true)
  minimumManualReviews Int                 @default(20)
  commercialUseAllowed Boolean             @default(false)
  excerptAllowed       Boolean             @default(false)
  imageUseAllowed      Boolean             @default(false)
  attributionRequired  Boolean             @default(true)
  termsUrl             String?             @db.VarChar(500)
  lastTermsCheckedAt   DateTime?
  lastFetchedAt        DateTime?
  lastSuccessAt        DateTime?
  lastError            String?             @db.VarChar(500)
  failureCount         Int                 @default(0)
  nextFetchAt          DateTime?
  fetchIntervalMinutes Int                 @default(30)
  priority             Int                 @default(100)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  articles             NewsArticle[]

  @@index([isActive, nextFetchAt, priority])
  @@map("news_sources")
}

model NewsArticle {
  id                        String                @id @default(cuid())
  sourceId                  String?
  providerNewsId            String?               @db.VarChar(191)
  slug                      String                @unique @db.VarChar(191)
  originalUrl               String                @unique @db.VarChar(700)
  canonicalUrl              String?               @db.VarChar(700)
  title                     String                @db.VarChar(500)
  excerpt                   String?               @db.Text
  titleTr                   String?               @db.VarChar(500)
  summaryTr                 String?               @db.Text
  localizedAt               DateTime?
  localizationError         String?               @db.VarChar(500)
  localizationAttempts      Int                   @default(0)
  aiStatus                  NewsAiStatus          @default(WAITING)
  localizationStartedAt     DateTime?
  nextLocalizationAttemptAt DateTime?
  manualEditedAt            DateTime?
  coverImageUrl             String?               @db.VarChar(1000)
  sourceImageUrl            String?               @db.VarChar(1000)
  coverImageAlt             String?               @db.VarChar(500)
  imageSyncError            String?               @db.VarChar(500)
  imageSyncAttempts         Int                   @default(0)
  imageSyncNextAttemptAt    DateTime?
  category                  String?               @db.VarChar(80)
  authorName                String?               @db.VarChar(160)
  language                  String                @default("tr") @db.VarChar(12)
  publishedAt               DateTime
  sourceUpdatedAt           DateTime?
  ingestedAt                DateTime              @default(now())
  status                    NewsPublicationStatus @default(PENDING)
  isExternal                Boolean               @default(true)
  isFeatured                Boolean               @default(false)
  isBreaking                Boolean               @default(false)
  isEditorPick              Boolean               @default(false)
  archivedAt                DateTime?
  editorialReviewedAt       DateTime?
  titleFingerprint          String                @db.VarChar(64)
  storyKey                  String?               @db.VarChar(120)
  readingTimeMinutes        Int                   @default(1)
  viewCount                 Int                   @default(0)
  source                    NewsSource?           @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  tags                      NewsArticleTag[]
  coins                     NewsArticleCoin[]
  relationsFrom             NewsArticleRelation[] @relation("news_relation_from")
  relationsTo               NewsArticleRelation[] @relation("news_relation_to")
  aiSummary                 NewsAiSummary?
  savedBy                   NewsSavedArticle[]
  analyticsEvents           NewsAnalyticsEvent[]

  @@unique([sourceId, providerNewsId])
  @@index([status, publishedAt])
  @@index([sourceId, editorialReviewedAt])
  @@index([isExternal, publishedAt])
  @@index([storyKey])
  @@index([aiStatus, nextLocalizationAttemptAt])
  @@index([imageSyncNextAttemptAt])
  @@map("news_articles")
}

model NewsAnalyticsEvent {
  id               String                 @id @default(cuid())
  type             NewsAnalyticsEventType
  articleId        String?
  sourceSlug       String?                @db.VarChar(80)
  category         String?                @db.VarChar(80)
  summaryWordCount Int?
  durationMs       Int?
  scrollDepth      Int?
  targetArticleId  String?                @db.VarChar(191)
  metricName       String?                @db.VarChar(20)
  metricValue      Decimal?               @db.Decimal(12, 3)
  pageType         String?                @db.VarChar(40)
  createdAt        DateTime               @default(now())
  article          NewsArticle?           @relation(fields: [articleId], references: [id], onDelete: SetNull)

  @@index([type, createdAt])
  @@index([articleId, createdAt])
  @@index([metricName, createdAt])
  @@map("news_analytics_events")
}

model NewsWorkerHealth {
  id               String    @id @db.VarChar(40)
  lastRunAt        DateTime?
  lastSuccessfulAt DateTime?
  pendingCount     Int       @default(0)
  processingCount  Int       @default(0)
  errorCount       Int       @default(0)
  rateLimitCount   Int       @default(0)
  lastError        String?   @db.VarChar(500)
  updatedAt        DateTime  @updatedAt

  @@map("news_worker_health")
}

model NewsTag {
  id       String           @id @default(cuid())
  slug     String           @unique @db.VarChar(100)
  name     String           @db.VarChar(100)
  articles NewsArticleTag[]

  @@map("news_tags")
}

model NewsArticleTag {
  articleId String
  tagId     String
  article   NewsArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag       NewsTag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
  @@index([tagId])
  @@map("news_article_tags")
}

model NewsArticleCoin {
  articleId String
  symbol    String      @db.VarChar(30)
  name      String?     @db.VarChar(100)
  article   NewsArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@id([articleId, symbol])
  @@index([symbol])
  @@map("news_article_coins")
}

model NewsArticleRelation {
  fromArticleId String
  toArticleId   String
  type          NewsRelationType
  fromArticle   NewsArticle      @relation("news_relation_from", fields: [fromArticleId], references: [id], onDelete: Cascade)
  toArticle     NewsArticle      @relation("news_relation_to", fields: [toArticleId], references: [id], onDelete: Cascade)

  @@id([fromArticleId, toArticleId, type])
  @@index([toArticleId, type])
  @@map("news_article_relations")
}

model NewsAiSummary {
  articleId     String      @id
  whyItMatters  String?     @db.Text
  marketImpact  String?     @db.Text
  watchOuts     String?     @db.Text
  confidence    Decimal?    @db.Decimal(5, 4)
  needsReview   Boolean     @default(false)
  wordCount     Int?
  qualityFlags  Json?
  provider      String?     @db.VarChar(80)
  model         String?     @db.VarChar(120)
  promptVersion String?     @db.VarChar(80)
  inputHash     String?     @db.VarChar(64)
  generatedAt   DateTime?
  article       NewsArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@map("news_ai_summaries")
}

model NewsSavedArticle {
  userId    String
  articleId String
  createdAt DateTime    @default(now())
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  article   NewsArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@id([userId, articleId])
  @@index([articleId])
  @@map("news_saved_articles")
}

model UserCapability {
  id         String               @id @default(cuid())
  userId     String
  type       UserCapabilityType
  status     UserCapabilityStatus @default(PENDING)
  appliedAt  DateTime             @default(now())
  approvedAt DateTime?
  rejectedAt DateTime?
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@index([type, status])
  @@map("user_capabilities")
}

model UserIdentity {
  id              String       @id @default(cuid())
  userId          String
  provider        AuthProvider
  providerSubject String       @db.VarChar(255)
  emailAtLink     String       @db.VarChar(320)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@index([userId, provider])
  @@map("user_identities")
}

model ProfileRole {
  id          String            @id @default(cuid())
  slug        String            @unique @db.VarChar(60)
  name        String            @db.VarChar(100)
  description String?           @db.VarChar(500)
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  users       UserProfileRole[]

  @@map("profile_roles")
}

model UserProfileRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())

  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role ProfileRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_profile_roles")
}

model ExchangeAccount {
  id                  String                   @id @default(cuid())
  userId              String
  name                String
  provider            ExchangeProvider
  environment         ExchangeEnvironment
  accountType         ExchangeAccountType
  apiKeyEncrypted     String                   @db.Text
  apiSecretEncrypted  String                   @db.Text
  passphraseEncrypted String?                  @db.Text
  apiKeyHint          String
  description         String?                  @db.Text
  isActive            Boolean                  @default(true)
  connectionStatus    ExchangeConnectionStatus @default(CONNECTED)
  canTrade            Boolean                  @default(false)
  withdrawalEnabled   Boolean                  @default(false)
  executionEngine     TradingExecutionEngine   @default(TYPESCRIPT)
  lastConnectedAt     DateTime?
  lastSyncAt          DateTime?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  manualOrderPreviews ManualOrderPreview[]
  tradingOrders       TradingOrder[]
  tradingAuditLogs    TradingAuditLog[]
  tradingOutboxEvents TradingOutboxEvent[]
  riskProfile         TradingRiskProfile?
  tradingRiskEvents   TradingRiskEvent[]
  tradingBots         TradingBot[]
  tradingBotDecisions TradingBotDecision[]
  tradingBotSignals   TradingBotSignal[]

  @@unique([userId, name])
  @@index([userId, provider])
  @@index([connectionStatus])
  @@map("exchange_accounts")
}

model TradingBot {
  id                String                 @id @default(cuid())
  userId            String
  exchangeAccountId String
  name              String                 @db.VarChar(100)
  type              TradingBotType
  mode              TradingBotMode
  state             TradingBotState        @default(DRAFT)
  desiredState      TradingBotDesiredState @default(STOPPED)
  symbol            String                 @db.VarChar(40)
  intervalSeconds   Int                    @default(60)
  configuration     Json
  stateReason       String?                @db.VarChar(500)
  lastErrorCode     String?                @db.VarChar(80)
  lastErrorMessage  String?                @db.VarChar(500)
  schedulerOwner    String?                @db.VarChar(120)
  leaseExpiresAt    DateTime?
  heartbeatAt       DateTime?
  lastDecisionAt    DateTime?
  startedAt         DateTime?
  stoppedAt         DateTime?
  version           Int                    @default(0)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  user            User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exchangeAccount ExchangeAccount          @relation(fields: [exchangeAccountId], references: [id], onDelete: Cascade)
  decisions       TradingBotDecision[]
  paperPosition   TradingBotPaperPosition?
  paperFills      TradingBotPaperFill[]
  signals         TradingBotSignal[]

  @@unique([userId, name])
  @@index([userId, state])
  @@index([exchangeAccountId, state])
  @@index([desiredState, leaseExpiresAt])
  @@index([schedulerOwner, leaseExpiresAt])
  @@map("trading_bots")
}

model TradingBotDecision {
  id                BigInt                 @id @default(autoincrement()) @db.UnsignedBigInt
  tradingBotId      String
  userId            String
  exchangeAccountId String
  type              TradingBotType
  mode              TradingBotMode
  symbol            String                 @db.VarChar(40)
  kind              TradingBotDecisionKind
  summary           String                 @db.VarChar(500)
  markPrice         Decimal                @db.Decimal(36, 18)
  referencePrice    Decimal?               @db.Decimal(36, 18)
  hypotheticalOrder Json?
  metrics           Json?
  occurredAt        DateTime
  createdAt         DateTime               @default(now())

  tradingBot      TradingBot           @relation(fields: [tradingBotId], references: [id], onDelete: Cascade)
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  exchangeAccount ExchangeAccount      @relation(fields: [exchangeAccountId], references: [id], onDelete: Cascade)
  paperFill       TradingBotPaperFill?
  signals         TradingBotSignal[]

  @@index([tradingBotId, id])
  @@index([userId, occurredAt])
  @@index([exchangeAccountId, occurredAt])
  @@index([kind, occurredAt])
  @@map("trading_bot_decisions")
}

model TradingBotPaperPosition {
  tradingBotId  String    @id
  symbol        String    @db.VarChar(40)
  netQuantity   Decimal   @default(0) @db.Decimal(36, 18)
  avgEntryPrice Decimal   @default(0) @db.Decimal(36, 18)
  realizedPnl   Decimal   @default(0) @db.Decimal(36, 18)
  unrealizedPnl Decimal   @default(0) @db.Decimal(36, 18)
  totalFees     Decimal   @default(0) @db.Decimal(36, 18)
  lastMarkPrice Decimal   @default(0) @db.Decimal(36, 18)
  totalFills    Int       @default(0)
  openedAt      DateTime?
  lastFilledAt  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tradingBot TradingBot @relation(fields: [tradingBotId], references: [id], onDelete: Cascade)

  @@index([symbol])
  @@map("trading_bot_paper_positions")
}

model TradingBotPaperFill {
  id           BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  tradingBotId String
  decisionId   BigInt              @unique @db.UnsignedBigInt
  side         TradingBotPaperSide
  quantity     Decimal             @db.Decimal(36, 18)
  markPrice    Decimal             @db.Decimal(36, 18)
  fillPrice    Decimal             @db.Decimal(36, 18)
  notional     Decimal             @db.Decimal(36, 18)
  fee          Decimal             @db.Decimal(36, 18)
  realizedPnl  Decimal             @db.Decimal(36, 18)
  slippageBps  Decimal             @db.Decimal(12, 4)
  feeBps       Decimal             @db.Decimal(12, 4)
  occurredAt   DateTime
  createdAt    DateTime            @default(now())

  tradingBot TradingBot         @relation(fields: [tradingBotId], references: [id], onDelete: Cascade)
  decision   TradingBotDecision @relation(fields: [decisionId], references: [id], onDelete: Cascade)

  @@index([tradingBotId, id])
  @@index([occurredAt])
  @@map("trading_bot_paper_fills")
}

model TradingBotSignal {
  id                BigInt                 @id @default(autoincrement()) @db.UnsignedBigInt
  tradingBotId      String
  userId            String
  exchangeAccountId String
  decisionId        BigInt?                @db.UnsignedBigInt
  source            TradingBotSignalSource
  action            TradingBotSignalAction
  status            TradingBotSignalStatus @default(OBSERVED)
  confidence        Decimal                @db.Decimal(5, 4)
  rationale         String                 @db.VarChar(1000)
  modelProvider     String?                @db.VarChar(80)
  modelName         String?                @db.VarChar(120)
  promptVersion     String?                @db.VarChar(80)
  features          Json?
  safetyChecks      Json
  expiresAt         DateTime?
  decidedAt         DateTime?
  createdAt         DateTime               @default(now())

  tradingBot      TradingBot          @relation(fields: [tradingBotId], references: [id], onDelete: Cascade)
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  exchangeAccount ExchangeAccount     @relation(fields: [exchangeAccountId], references: [id], onDelete: Cascade)
  decision        TradingBotDecision? @relation(fields: [decisionId], references: [id], onDelete: SetNull)

  @@index([tradingBotId, id])
  @@index([decisionId])
  @@index([userId, createdAt])
  @@index([source, status, createdAt])
  @@map("trading_bot_signals")
}

model ManualOrderPreview {
  id                String            @id @default(cuid())
  userId            String
  exchangeAccountId String
  symbol            String            @db.VarChar(40)
  side              TradingOrderSide
  type              TradingOrderType
  quantity          Decimal           @db.Decimal(36, 18)
  price             Decimal?          @db.Decimal(36, 18)
  stopPrice         Decimal?          @db.Decimal(36, 18)
  leverage          Int
  marginMode        TradingMarginMode
  reduceOnly        Boolean           @default(false)
  markPrice         Decimal           @db.Decimal(36, 18)
  estimatedNotional Decimal           @db.Decimal(36, 18)
  expiresAt         DateTime
  consumedAt        DateTime?
  createdAt         DateTime          @default(now())

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  exchangeAccount ExchangeAccount @relation(fields: [exchangeAccountId], references: [id], onDelete: Cascade)
  order           TradingOrder?

  @@index([userId, expiresAt])
  @@index([exchangeAccountId, symbol])
  @@map("manual_order_previews")
}

model TradingOrder {
  id                   String                 @id @default(cuid())
  userId               String
  exchangeAccountId    String
  previewId            String                 @unique
  idempotencyKey       String                 @db.VarChar(80)
  clientOrderId        String                 @unique @db.VarChar(36)
  exchangeOrderId      String?                @db.VarChar(100)
  symbol               String                 @db.VarChar(40)
  side                 TradingOrderSide
  type                 TradingOrderType
  quantity             Decimal                @db.Decimal(36, 18)
  price                Decimal?               @db.Decimal(36, 18)
  stopPrice            Decimal?               @db.Decimal(36, 18)
  leverage             Int
  marginMode           TradingMarginMode
  reduceOnly           Boolean                @default(false)
  source               TradingOrderSource     @default(MANUAL)
  executionEngine      TradingExecutionEngine @default(TYPESCRIPT)
  status               TradingOrderStatus     @default(SUBMITTING)
  executionAttemptedAt DateTime?
  cancelIdempotencyKey String?                @db.VarChar(80)
  cancelClientOrderId  String?                @db.VarChar(36)
  cancelAttemptedAt    DateTime?
  failureCode          String?                @db.VarChar(80)
  failureMessage       String?                @db.VarChar(500)
  submittedAt          DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  exchangeAccount ExchangeAccount    @relation(fields: [exchangeAccountId], references: [id], onDelete: Cascade)
  preview         ManualOrderPreview @relation(fields: [previewId], references: [id], onDelete: Restrict)
  riskEvents      TradingRiskEvent[]

  @@unique([userId, idempotencyKey])
  @@unique([userId, cancelIdempotencyKey])
  @@index([exchangeAccountId, status])
  @@index([userId, createdAt])
  @@index([executionEngine, status])
  @@map("trading_orders")
}

model TradingRiskProfile {
  id                     String   @id @default(cuid())
  userId                 String
  exchangeAccountId      String   @unique
  enabled                Boolean  @default(true)
  accountKillSwitch      Boolean  @default(false)
  killSwitchReason       String?  @db.VarChar(500)
  maxOrderNotional       Decimal  @default(100) @db.Decimal(36, 18)
  maxInitialMargin       Decimal  @default(50) @db.Decimal(36, 18)
  maxAccountOpenNotional Decimal  @default(500) @db.Decimal(36, 18)
  maxOpenPositions       Int      @default(5)
  maxSymbolPositions     Int      @default(1)
  maxLeverage            Int      @default(5)
  minAvailableBalance    Decimal  @default(20) @db.Decimal(36, 18)
  maxOrdersPerMinute     Int      @default(10)
  maxDailyOrders         Int      @default(100)
  maxDailyLoss           Decimal? @db.Decimal(36, 18)
  allowedSymbols         Json?
  blockedSymbols         Json?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  exchangeAccount ExchangeAccount @relation(fields: [exchangeAccountId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([enabled, accountKillSwitch])
  @@map("trading_risk_profiles")
}

model TradingRiskControl {
  id               String    @id @default("global") @db.VarChar(40)
  globalKillSwitch Boolean   @default(false)
  reason           String?   @db.VarChar(500)
  activatedBy      String?   @db.VarChar(100)
  activatedAt      DateTime?
  updatedAt        DateTime  @updatedAt

  @@map("trading_risk_controls")
}

model TradingRiskEvent {
  id                BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  userId            String
  exchangeAccountId String
  tradingOrderId    String?
  source            TradingOrderSource
  decision          TradingRiskDecision
  code              String              @db.VarChar(80)
  message           String              @db.VarChar(500)
  metrics           Json?
  occurredAt        DateTime
  createdAt         DateTime            @default(now())

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  exchangeAccount ExchangeAccount @relation(fields: [exchangeAccountId], references: [id], onDelete: Cascade)
  tradingOrder    TradingOrder?   @relation(fields: [tradingOrderId], references: [id], onDelete: SetNull)

  @@index([userId, occurredAt])
  @@index([exchangeAccountId, occurredAt])
  @@index([tradingOrderId])
  @@index([decision, occurredAt])
  @@map("trading_risk_events")
}

model TradingAuditLog {
  id                String   @id @default(cuid())
  userId            String
  exchangeAccountId String?
  action            String   @db.VarChar(80)
  entityType        String   @db.VarChar(50)
  entityId          String?  @db.VarChar(100)
  metadata          Json?
  ipAddress         String?  @db.VarChar(64)
  createdAt         DateTime @default(now())

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  exchangeAccount ExchangeAccount? @relation(fields: [exchangeAccountId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([exchangeAccountId, createdAt])
  @@map("trading_audit_logs")
}

model TradingOutboxEvent {
  id                BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  userId            String
  exchangeAccountId String
  provider          ExchangeProvider
  topic             String           @db.VarChar(80)
  eventType         String           @db.VarChar(80)
  aggregateType     String?          @db.VarChar(50)
  aggregateId       String?          @db.VarChar(120)
  deduplicationKey  String           @unique @db.VarChar(191)
  payload           Json
  occurredAt        DateTime
  publishedAt       DateTime?
  createdAt         DateTime         @default(now())

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  exchangeAccount ExchangeAccount @relation(fields: [exchangeAccountId], references: [id], onDelete: Cascade)

  @@index([userId, id])
  @@index([exchangeAccountId, id])
  @@index([publishedAt, id])
  @@map("trading_outbox_events")
}

model RefreshSession {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  ipAddress String?
  userAgent String?   @db.Text
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_sessions")
}
