  executionEngine      TradingExecutionEngine @default(TYPESCRIPT)
  status               TradingOrderStatus     @default(SUBMITTING)
  executionAttemptedAt DateTime?
  cancelIdempotencyKey String?                @db.VarChar(80)
  cancelClientOrderId  String?                @db.VarChar(36)
  cancelAttemptedAt    DateTime?
  failureCode          String?                @db.VarChar(80)
  failureMessage       String?                @db.VarChar(500)
  submittedAt          DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  exchangeAccount ExchangeAccount    @relation(fields: [exchangeAccountId], references: [id], onDelete: Cascade)
  preview         ManualOrderPreview @relation(fields: [previewId], references: [id], onDelete: Restrict)
  riskEvents      TradingRiskEvent[]

  @@unique([userId, idempotencyKey])
  @@unique([userId, cancelIdempotencyKey])
  @@index([exchangeAccountId, status])
  @@index([userId, createdAt])
  @@index([executionEngine, status])
  @@map("trading_orders")
}

model TradingRiskProfile {
  id                     String   @id @default(cuid())
  userId                 String
  exchangeAccountId      String   @unique
  enabled                Boolean  @default(true)
  accountKillSwitch      Boolean  @default(false)
  killSwitchReason       String?  @db.VarChar(500)
  maxOrderNotional       Decimal  @default(100) @db.Decimal(36, 18)
  maxInitialMargin       Decimal  @default(50) @db.Decimal(36, 18)
  maxAccountOpenNotional Decimal  @default(500) @db.Decimal(36, 18)
  maxOpenPositions       Int      @default(5)
  maxSymbolPositions     Int      @default(1)
  maxLeverage            Int      @default(5)
  minAvailableBalance    Decimal  @default(20) @db.Decimal(36, 18)
  maxOrdersPerMinute     Int      @default(10)
  maxDailyOrders         Int      @default(100)
  maxDailyLoss           Decimal? @db.Decimal(36, 18)
  allowedSymbols         Json?
  blockedSymbols         Json?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  exchangeAccount ExchangeAccount @relation(fields: [exchangeAccountId], references: [id], onDelete: Cascade)
  autonomousBots TradingBot[]

  @@index([userId])
  @@index([enabled, accountKillSwitch])
  @@map("trading_risk_profiles")
}

model MarketRegimeSnapshot {
  id         BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  symbol     String       @db.VarChar(40)
  timeframe  String       @db.VarChar(20)
  regime     MarketRegime @default(UNKNOWN)
  confidence Decimal      @default(0) @db.Decimal(5, 4)
  features   Json?
  observedAt DateTime
  createdAt  DateTime     @default(now())

  paperTrades PaperTrade[]
  metrics     BotMetric[]

  @@index([symbol, timeframe, observedAt])
  @@index([regime, observedAt])
  @@map("market_regime_snapshots")
}

model PaperTrade {
  id                     String           @id @default(cuid())
  tradingBotId           String
  strategyVersionId      String?
  marketRegimeSnapshotId BigInt?          @db.UnsignedBigInt
  symbol                 String           @db.VarChar(40)
  side                   TradingBotPaperSide
  status                 PaperTradeStatus @default(OPEN)
  entryPrice             Decimal          @db.Decimal(36, 18)
  exitPrice              Decimal?         @db.Decimal(36, 18)
  quantity               Decimal          @db.Decimal(36, 18)
  leverage               Int              @default(1)
  fees                   Decimal          @default(0) @db.Decimal(36, 18)
  funding                Decimal          @default(0) @db.Decimal(36, 18)
  slippageCost           Decimal          @default(0) @db.Decimal(36, 18)
  realizedPnl            Decimal          @default(0) @db.Decimal(36, 18)
  stopLoss               Decimal?         @db.Decimal(36, 18)
  takeProfit             Decimal?         @db.Decimal(36, 18)
  maxFavorableExcursion  Decimal          @default(0) @db.Decimal(36, 18)
  maxAdverseExcursion    Decimal          @default(0) @db.Decimal(36, 18)
  holdingSeconds         Int?
  marketContext          Json?
  closeReason            String?          @db.VarChar(80)
  aiConfidence           Decimal?         @db.Decimal(5, 4)
  decisionSummary        String?          @db.VarChar(1000)
  openedAt               DateTime
  closedAt               DateTime?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  tradingBot           TradingBot           @relation(fields: [tradingBotId], references: [id], onDelete: Cascade)
  strategyVersion      StrategyVersion?      @relation(fields: [strategyVersionId], references: [id], onDelete: SetNull)
  marketRegimeSnapshot MarketRegimeSnapshot? @relation(fields: [marketRegimeSnapshotId], references: [id], onDelete: SetNull)

  @@index([tradingBotId, openedAt])
  @@index([strategyVersionId, openedAt])
  @@index([symbol, status, openedAt])
  @@index([marketRegimeSnapshotId])
  @@index([tradingBotId, status, realizedPnl])
  @@index([strategyVersionId, status, realizedPnl])
  @@index([marketRegimeSnapshotId, status, realizedPnl])
  @@index([symbol, side, status, realizedPnl])
  @@map("paper_trades")
}

model BotMetric {
  id                     BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  tradingBotId           String
  strategyVersionId      String?
  marketRegimeSnapshotId BigInt?  @db.UnsignedBigInt
  startingBalance        Decimal  @db.Decimal(36, 18)
  currentEquity          Decimal  @db.Decimal(36, 18)
  realizedPnl            Decimal  @default(0) @db.Decimal(36, 18)
  unrealizedPnl          Decimal  @default(0) @db.Decimal(36, 18)
  netPnl                 Decimal  @default(0) @db.Decimal(36, 18)
  totalTrades            Int      @default(0)
  wins                   Int      @default(0)
  losses                 Int      @default(0)
  maxDrawdown            Decimal  @default(0) @db.Decimal(12, 6)
  score                  Decimal? @db.Decimal(8, 4)
  metrics                Json?
  snapshotAt             DateTime
  createdAt              DateTime @default(now())

  tradingBot           TradingBot           @relation(fields: [tradingBotId], references: [id], onDelete: Cascade)
  strategyVersion      StrategyVersion?      @relation(fields: [strategyVersionId], references: [id], onDelete: SetNull)
  marketRegimeSnapshot MarketRegimeSnapshot? @relation(fields: [marketRegimeSnapshotId], references: [id], onDelete: SetNull)

  @@index([tradingBotId, snapshotAt])
  @@index([strategyVersionId, snapshotAt])
  @@index([marketRegimeSnapshotId, snapshotAt])
  @@index([score, snapshotAt])
  @@map("bot_metrics")
}

model TeacherEvaluation {
  id                BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  tradingBotId      String?
  strategyId        String?
  observation       String   @db.VarChar(1000)
  severity          String   @db.VarChar(20)
  confidence        Decimal  @db.Decimal(5, 4)
  metricEvidence    Json
  recommendedAction Json
  analyzer          String   @default("RULE_BASED") @db.VarChar(40)
  createdAt         DateTime @default(now())

  tradingBot TradingBot? @relation(fields: [tradingBotId], references: [id], onDelete: SetNull)
  strategy   Strategy?   @relation(fields: [strategyId], references: [id], onDelete: SetNull)

  @@index([tradingBotId, createdAt])
  @@index([strategyId, createdAt])
  @@index([severity, createdAt])
  @@map("teacher_evaluations")
}

model ResearchHypothesis {
  id                   String         @id @default(cuid())
  createdById          String
  hypothesis           String         @db.VarChar(1500)
  evidence             Json
  targetStrategyFamily StrategyFamily
  suggestedChange      Json
  confidence           Decimal        @db.Decimal(5, 4)
  status               String         @default("DRAFT") @db.VarChar(30)
  provider             String         @default("RULE_TEMPLATE") @db.VarChar(40)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@index([createdById, status, createdAt])
  @@index([targetStrategyFamily, status, confidence])
  @@map("research_hypotheses")
}

model BotMutation {
  id           String   @id @default(cuid())
  parentBotId  String
  childBotId   String   @unique
  generationId String
  reason       String   @db.VarChar(1000)
  diff         Json
  createdAt    DateTime @default(now())

  parentBot  TradingBot @relation("mutation_parent", fields: [parentBotId], references: [id], onDelete: Restrict)
  childBot   TradingBot @relation("mutation_child", fields: [childBotId], references: [id], onDelete: Cascade)
  generation Generation @relation(fields: [generationId], references: [id], onDelete: Cascade)

  @@index([parentBotId, createdAt])
  @@index([generationId, createdAt])
  @@map("bot_mutations")
}

model EvolutionRun {
  id                 String   @id @default(cuid())
  createdById        String
  sourceGenerationId String
  targetGenerationId String?  @unique
  status             String   @default("RUNNING") @db.VarChar(30)
  config             Json
  evidence           Json?
  selection          Json?
  errorMessage       String?  @db.VarChar(1000)
  startedAt          DateTime @default(now())
  completedAt        DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  sourceGeneration Generation  @relation("evolution_source_generation", fields: [sourceGenerationId], references: [id], onDelete: Restrict)
  targetGeneration Generation? @relation("evolution_target_generation", fields: [targetGenerationId], references: [id], onDelete: SetNull)

  @@index([createdById, status, createdAt])
  @@index([sourceGenerationId, createdAt])
  @@map("evolution_runs")
}

model BotCrossover {
  id              String   @id @default(cuid())
  parentABotId    String
  parentBBotId    String
  childBotId      String   @unique
  generationId    String
  inheritedFields Json
  generatedFields Json
  createdAt       DateTime @default(now())

  parentA    TradingBot @relation("crossover_parent_a", fields: [parentABotId], references: [id], onDelete: Restrict)
  parentB    TradingBot @relation("crossover_parent_b", fields: [parentBBotId], references: [id], onDelete: Restrict)
  child      TradingBot @relation("crossover_child", fields: [childBotId], references: [id], onDelete: Cascade)
  generation Generation @relation(fields: [generationId], references: [id], onDelete: Cascade)

  @@index([parentABotId, createdAt])
  @@index([parentBBotId, createdAt])
  @@index([generationId, createdAt])
  @@map("bot_crossovers")
}

model ChampionCandidate {
  id           String                  @id @default(cuid())
  tradingBotId String
  status       ChampionCandidateStatus @default(PENDING)
  score        Decimal?                @db.Decimal(8, 4)
  evidence     Json?
  evaluatedAt  DateTime?
  promotedAt   DateTime?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  tradingBot TradingBot @relation(fields: [tradingBotId], references: [id], onDelete: Cascade)

  @@index([tradingBotId, createdAt])
  @@index([status, score])
  @@map("champion_candidates")
}

model TradingRiskControl {
  id               String    @id @default("global") @db.VarChar(40)
  globalKillSwitch Boolean   @default(false)
  reason           String?   @db.VarChar(500)
  activatedBy      String?   @db.VarChar(100)
  activatedAt      DateTime?
  updatedAt        DateTime  @updatedAt

  @@map("trading_risk_controls")
}

model TradingRiskEvent {
  id                BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  userId            String
  exchangeAccountId String
  tradingOrderId    String?
  source            TradingOrderSource
  decision          TradingRiskDecision
  code              String              @db.VarChar(80)
  message           String              @db.VarChar(500)
  metrics           Json?
  occurredAt        DateTime
  createdAt         DateTime            @default(now())

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  exchangeAccount ExchangeAccount @relation(fields: [exchangeAccountId], references: [id], onDelete: Cascade)
  tradingOrder    TradingOrder?   @relation(fields: [tradingOrderId], references: [id], onDelete: SetNull)

  @@index([userId, occurredAt])
  @@index([exchangeAccountId, occurredAt])
  @@index([tradingOrderId])
  @@index([decision, occurredAt])
  @@map("trading_risk_events")
}

model TradingAuditLog {
  id                String   @id @default(cuid())
  userId            String
  exchangeAccountId String?
  action            String   @db.VarChar(80)
  entityType        String   @db.VarChar(50)
  entityId          String?  @db.VarChar(100)
  metadata          Json?
  ipAddress         String?  @db.VarChar(64)
  createdAt         DateTime @default(now())

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  exchangeAccount ExchangeAccount? @relation(fields: [exchangeAccountId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([exchangeAccountId, createdAt])
  @@map("trading_audit_logs")
}

model TradingOutboxEvent {
  id                BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  userId            String
  exchangeAccountId String
  provider          ExchangeProvider
  topic             String           @db.VarChar(80)
  eventType         String           @db.VarChar(80)
  aggregateType     String?          @db.VarChar(50)
  aggregateId       String?          @db.VarChar(120)
  deduplicationKey  String           @unique @db.VarChar(191)
  payload           Json
  occurredAt        DateTime
  publishedAt       DateTime?
  createdAt         DateTime         @default(now())

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  exchangeAccount ExchangeAccount @relation(fields: [exchangeAccountId], references: [id], onDelete: Cascade)

  @@index([userId, id])
  @@index([exchangeAccountId, id])
  @@index([publishedAt, id])
  @@map("trading_outbox_events")
}

model RefreshSession {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  ipAddress String?
  userAgent String?   @db.Text
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_sessions")
}
