generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  USER
}

enum UserStatus {
  ACTIVE
  PENDING
  PASSIVE
  SUSPENDED
  DELETED
}

enum UserCapabilityType {
  CREATOR
  AUTHOR
  PROJECT_OWNER
  DEVELOPER
}

enum UserCapabilityStatus {
  NOT_APPLIED
  PENDING
  APPROVED
  REJECTED
}

enum AuthProvider {
  GOOGLE
}

enum ExchangeProvider {
  BINANCE
  BYBIT
}

enum ExchangeEnvironment {
  TESTNET
  DEMO
}

enum ExchangeAccountType {
  USDT_M
  UNIFIED
}

enum ExchangeConnectionStatus {
  CONNECTED
  DEGRADED
  ERROR
  DISABLED
}

enum TradingExecutionEngine {
  TYPESCRIPT
  GO
}

enum TradingOrderSide {
  BUY
  SELL
}

enum TradingOrderType {
  MARKET
  LIMIT
  STOP_MARKET
  STOP_LIMIT
}

enum TradingMarginMode {
  ISOLATED
  CROSS
}

enum TradingOrderStatus {
  PENDING
  SUBMITTING
  OPEN
  PARTIALLY_FILLED
  FILLED
  CANCELING
  CANCELED
  CLOSING
  FAILED
  RECONCILIATION_REQUIRED
}

enum TradingOrderSource {
  MANUAL
  SCALPING_BOT
  GRID_BOT
  SYSTEM
  RISK_ENGINE
}

enum TradingRiskDecision {
  APPROVED
  REJECTED
  RISK_BLOCKED
  SYSTEM_BLOCKED
}

enum TradingBotType {
  SCALPING
  GRID
}

enum TradingBotMode {
  SHADOW
  PAPER
  DEMO
}

enum TradingBotState {
  DRAFT
  VALIDATING
  STARTING
  RUNNING
  PAUSED
  STOPPED
  RISK_BLOCKED
  RECONCILING
  EMERGENCY_STOPPED
  ERROR
}

enum TradingBotDesiredState {
  RUNNING
  PAUSED
  STOPPED
}

enum TradingBotDecisionKind {
  WARMING_UP
  HOLD
  BUY
  SELL
  GRID_BUY
  GRID_SELL
  OUT_OF_RANGE
}

enum TradingBotPaperSide {
  BUY
  SELL
}

enum TradingBotSignalSource {
  RULE_ENGINE
  AI_MODEL
}

enum TradingBotSignalAction {
  HOLD
  BUY
  SELL
}

enum TradingBotSignalStatus {
  OBSERVED
  ACCEPTED
  REJECTED
  EXPIRED
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  passwordHash        String?
  name                String?
  username            String               @unique @db.VarChar(30)
  avatarUrl           String?              @db.VarChar(500)
  bio                 String?              @db.VarChar(500)
  emailVerifiedAt     DateTime?
  termsAcceptedAt     DateTime?
  privacyAcceptedAt   DateTime?
  role                UserRole             @default(USER)
  status              UserStatus           @default(ACTIVE)
  mustChangePassword  Boolean              @default(false)
  profileCompleted    Boolean              @default(false)
  onboardingCompleted Boolean              @default(false)
  lastLoginAt         DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  refreshSessions     RefreshSession[]
  exchangeAccounts    ExchangeAccount[]
  manualOrderPreviews ManualOrderPreview[]
  tradingOrders       TradingOrder[]
  tradingAuditLogs    TradingAuditLog[]
  tradingOutboxEvents TradingOutboxEvent[]
  tradingRiskProfiles TradingRiskProfile[]
  tradingRiskEvents   TradingRiskEvent[]
  tradingBots         TradingBot[]
  tradingBotDecisions TradingBotDecision[]
  tradingBotSignals   TradingBotSignal[]
  identities          UserIdentity[]
  profileRoles        UserProfileRole[]
  capabilities        UserCapability[]

  @@map("users")
}

model UserCapability {
  id         String               @id @default(cuid())
  userId     String
  type       UserCapabilityType
  status     UserCapabilityStatus @default(PENDING)
  appliedAt  DateTime             @default(now())
  approvedAt DateTime?
  rejectedAt DateTime?
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@index([type, status])
  @@map("user_capabilities")
}

model UserIdentity {
  id              String       @id @default(cuid())
  userId          String
  provider        AuthProvider
  providerSubject String       @db.VarChar(255)
  emailAtLink     String       @db.VarChar(320)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@index([userId, provider])
  @@map("user_identities")
}

model ProfileRole {
  id          String            @id @default(cuid())
  slug        String            @unique @db.VarChar(60)
  name        String            @db.VarChar(100)
  description String?           @db.VarChar(500)
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  users       UserProfileRole[]

  @@map("profile_roles")
}

model UserProfileRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())

  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role ProfileRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_profile_roles")
}

model ExchangeAccount {
  id                  String                   @id @default(cuid())
  userId              String
  name                String
  provider            ExchangeProvider
  environment         ExchangeEnvironment
  accountType         ExchangeAccountType
  apiKeyEncrypted     String                   @db.Text
  apiSecretEncrypted  String                   @db.Text
  passphraseEncrypted String?                  @db.Text
  apiKeyHint          String
  description         String?                  @db.Text
  isActive            Boolean                  @default(true)
  connectionStatus    ExchangeConnectionStatus @default(CONNECTED)
  canTrade            Boolean                  @default(false)
  withdrawalEnabled   Boolean                  @default(false)
  executionEngine     TradingExecutionEngine   @default(TYPESCRIPT)
  lastConnectedAt     DateTime?
  lastSyncAt          DateTime?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  manualOrderPreviews ManualOrderPreview[]
  tradingOrders       TradingOrder[]
  tradingAuditLogs    TradingAuditLog[]
  tradingOutboxEvents TradingOutboxEvent[]
  riskProfile         TradingRiskProfile?
  tradingRiskEvents   TradingRiskEvent[]
  tradingBots         TradingBot[]
  tradingBotDecisions TradingBotDecision[]
  tradingBotSignals   TradingBotSignal[]

  @@unique([userId, name])
  @@index([userId, provider])
  @@index([connectionStatus])
  @@map("exchange_accounts")
}

model TradingBot {
  id                String                 @id @default(cuid())
  userId            String
  exchangeAccountId String
  name              String                 @db.VarChar(100)
  type              TradingBotType
  mode              TradingBotMode
  state             TradingBotState        @default(DRAFT)
  desiredState      TradingBotDesiredState @default(STOPPED)
  symbol            String                 @db.VarChar(40)
  intervalSeconds   Int                    @default(60)
  configuration     Json
  stateReason       String?                @db.VarChar(500)
  lastErrorCode     String?                @db.VarChar(80)
  lastErrorMessage  String?                @db.VarChar(500)
  schedulerOwner    String?                @db.VarChar(120)
  leaseExpiresAt    DateTime?
  heartbeatAt       DateTime?
  lastDecisionAt    DateTime?
  startedAt         DateTime?
  stoppedAt         DateTime?
  version           Int                    @default(0)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  user            User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exchangeAccount ExchangeAccount          @relation(fields: [exchangeAccountId], references: [id], onDelete: Cascade)
  decisions       TradingBotDecision[]
  paperPosition   TradingBotPaperPosition?
  paperFills      TradingBotPaperFill[]
  signals         TradingBotSignal[]

  @@unique([userId, name])
  @@index([userId, state])
  @@index([exchangeAccountId, state])
  @@index([desiredState, leaseExpiresAt])
  @@index([schedulerOwner, leaseExpiresAt])
  @@map("trading_bots")
}

model TradingBotDecision {
  id                BigInt                 @id @default(autoincrement()) @db.UnsignedBigInt
  tradingBotId      String
  userId            String
  exchangeAccountId String
  type              TradingBotType
  mode              TradingBotMode
  symbol            String                 @db.VarChar(40)
  kind              TradingBotDecisionKind
  summary           String                 @db.VarChar(500)
  markPrice         Decimal                @db.Decimal(36, 18)
  referencePrice    Decimal?               @db.Decimal(36, 18)
  hypotheticalOrder Json?
  metrics           Json?
  occurredAt        DateTime
  createdAt         DateTime               @default(now())

  tradingBot      TradingBot           @relation(fields: [tradingBotId], references: [id], onDelete: Cascade)
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  exchangeAccount ExchangeAccount      @relation(fields: [exchangeAccountId], references: [id], onDelete: Cascade)
  paperFill       TradingBotPaperFill?
  signals         TradingBotSignal[]

  @@index([tradingBotId, id])
  @@index([userId, occurredAt])
  @@index([exchangeAccountId, occurredAt])
  @@index([kind, occurredAt])
  @@map("trading_bot_decisions")
}

model TradingBotPaperPosition {
  tradingBotId  String    @id
  symbol        String    @db.VarChar(40)
  netQuantity   Decimal   @default(0) @db.Decimal(36, 18)
  avgEntryPrice Decimal   @default(0) @db.Decimal(36, 18)
  realizedPnl   Decimal   @default(0) @db.Decimal(36, 18)
  unrealizedPnl Decimal   @default(0) @db.Decimal(36, 18)
  totalFees     Decimal   @default(0) @db.Decimal(36, 18)
  lastMarkPrice Decimal   @default(0) @db.Decimal(36, 18)
  totalFills    Int       @default(0)
  openedAt      DateTime?
  lastFilledAt  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tradingBot TradingBot @relation(fields: [tradingBotId], references: [id], onDelete: Cascade)

  @@index([symbol])
  @@map("trading_bot_paper_positions")
}

model TradingBotPaperFill {
  id           BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  tradingBotId String
  decisionId   BigInt              @unique @db.UnsignedBigInt
  side         TradingBotPaperSide
  quantity     Decimal             @db.Decimal(36, 18)
  markPrice    Decimal             @db.Decimal(36, 18)
  fillPrice    Decimal             @db.Decimal(36, 18)
  notional     Decimal             @db.Decimal(36, 18)
  fee          Decimal             @db.Decimal(36, 18)
  realizedPnl  Decimal             @db.Decimal(36, 18)
  slippageBps  Decimal             @db.Decimal(12, 4)
  feeBps       Decimal             @db.Decimal(12, 4)
  occurredAt   DateTime
  createdAt    DateTime            @default(now())

  tradingBot TradingBot         @relation(fields: [tradingBotId], references: [id], onDelete: Cascade)
  decision   TradingBotDecision @relation(fields: [decisionId], references: [id], onDelete: Cascade)

  @@index([tradingBotId, id])
  @@index([occurredAt])
  @@map("trading_bot_paper_fills")
}

model TradingBotSignal {
  id                BigInt                 @id @default(autoincrement()) @db.UnsignedBigInt
  tradingBotId      String
  userId            String
  exchangeAccountId String
  decisionId        BigInt?                @db.UnsignedBigInt
  source            TradingBotSignalSource
  action            TradingBotSignalAction
  status            TradingBotSignalStatus @default(OBSERVED)
  confidence        Decimal                @db.Decimal(5, 4)
  rationale         String                 @db.VarChar(1000)
  modelProvider     String?                @db.VarChar(80)
  modelName         String?                @db.VarChar(120)
  promptVersion     String?                @db.VarChar(80)
  features          Json?
  safetyChecks      Json
  expiresAt         DateTime?
  decidedAt         DateTime?
  createdAt         DateTime               @default(now())

  tradingBot      TradingBot          @relation(fields: [tradingBotId], references: [id], onDelete: Cascade)
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  exchangeAccount ExchangeAccount     @relation(fields: [exchangeAccountId], references: [id], onDelete: Cascade)
  decision        TradingBotDecision? @relation(fields: [decisionId], references: [id], onDelete: SetNull)

  @@index([tradingBotId, id])
  @@index([decisionId])
  @@index([userId, createdAt])
  @@index([source, status, createdAt])
  @@map("trading_bot_signals")
}

model ManualOrderPreview {
  id                String            @id @default(cuid())
  userId            String
  exchangeAccountId String
  symbol            String            @db.VarChar(40)
  side              TradingOrderSide
  type              TradingOrderType
  quantity          Decimal           @db.Decimal(36, 18)
  price             Decimal?          @db.Decimal(36, 18)
  stopPrice         Decimal?          @db.Decimal(36, 18)
  leverage          Int
  marginMode        TradingMarginMode
  reduceOnly        Boolean           @default(false)
  markPrice         Decimal           @db.Decimal(36, 18)
  estimatedNotional Decimal           @db.Decimal(36, 18)
  expiresAt         DateTime
  consumedAt        DateTime?
  createdAt         DateTime          @default(now())

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  exchangeAccount ExchangeAccount @relation(fields: [exchangeAccountId], references: [id], onDelete: Cascade)
  order           TradingOrder?

  @@index([userId, expiresAt])
  @@index([exchangeAccountId, symbol])
  @@map("manual_order_previews")
}

model TradingOrder {
  id                   String                 @id @default(cuid())
  userId               String
  exchangeAccountId    String
  previewId            String                 @unique
  idempotencyKey       String                 @db.VarChar(80)
  clientOrderId        String                 @unique @db.VarChar(36)
  exchangeOrderId      String?                @db.VarChar(100)
  symbol               String                 @db.VarChar(40)
  side                 TradingOrderSide
  type                 TradingOrderType
  quantity             Decimal                @db.Decimal(36, 18)
  price                Decimal?               @db.Decimal(36, 18)
  stopPrice            Decimal?               @db.Decimal(36, 18)
  leverage             Int
  marginMode           TradingMarginMode
  reduceOnly           Boolean                @default(false)
  source               TradingOrderSource     @default(MANUAL)
  executionEngine      TradingExecutionEngine @default(TYPESCRIPT)
  status               TradingOrderStatus     @default(SUBMITTING)
  executionAttemptedAt DateTime?
  cancelIdempotencyKey String?                @db.VarChar(80)
  cancelClientOrderId  String?                @db.VarChar(36)
  cancelAttemptedAt    DateTime?
  failureCode          String?                @db.VarChar(80)
  failureMessage       String?                @db.VarChar(500)
  submittedAt          DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  exchangeAccount ExchangeAccount    @relation(fields: [exchangeAccountId], references: [id], onDelete: Cascade)
  preview         ManualOrderPreview @relation(fields: [previewId], references: [id], onDelete: Restrict)
  riskEvents      TradingRiskEvent[]

  @@unique([userId, idempotencyKey])
  @@unique([userId, cancelIdempotencyKey])
  @@index([exchangeAccountId, status])
  @@index([userId, createdAt])
  @@index([executionEngine, status])
  @@map("trading_orders")
}

model TradingRiskProfile {
  id                     String   @id @default(cuid())
  userId                 String
  exchangeAccountId      String   @unique
  enabled                Boolean  @default(true)
  accountKillSwitch      Boolean  @default(false)
  killSwitchReason       String?  @db.VarChar(500)
  maxOrderNotional       Decimal  @default(100) @db.Decimal(36, 18)
  maxInitialMargin       Decimal  @default(50) @db.Decimal(36, 18)
  maxAccountOpenNotional Decimal  @default(500) @db.Decimal(36, 18)
  maxOpenPositions       Int      @default(5)
  maxSymbolPositions     Int      @default(1)
  maxLeverage            Int      @default(5)
  minAvailableBalance    Decimal  @default(20) @db.Decimal(36, 18)
  maxOrdersPerMinute     Int      @default(10)
  maxDailyOrders         Int      @default(100)
  maxDailyLoss           Decimal? @db.Decimal(36, 18)
  allowedSymbols         Json?
  blockedSymbols         Json?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  exchangeAccount ExchangeAccount @relation(fields: [exchangeAccountId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([enabled, accountKillSwitch])
  @@map("trading_risk_profiles")
}

model TradingRiskControl {
  id               String    @id @default("global") @db.VarChar(40)
  globalKillSwitch Boolean   @default(false)
  reason           String?   @db.VarChar(500)
  activatedBy      String?   @db.VarChar(100)
  activatedAt      DateTime?
  updatedAt        DateTime  @updatedAt

  @@map("trading_risk_controls")
}

model TradingRiskEvent {
  id                BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  userId            String
  exchangeAccountId String
  tradingOrderId    String?
  source            TradingOrderSource
  decision          TradingRiskDecision
  code              String              @db.VarChar(80)
  message           String              @db.VarChar(500)
  metrics           Json?
  occurredAt        DateTime
  createdAt         DateTime            @default(now())

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  exchangeAccount ExchangeAccount @relation(fields: [exchangeAccountId], references: [id], onDelete: Cascade)
  tradingOrder    TradingOrder?   @relation(fields: [tradingOrderId], references: [id], onDelete: SetNull)

  @@index([userId, occurredAt])
  @@index([exchangeAccountId, occurredAt])
  @@index([tradingOrderId])
  @@index([decision, occurredAt])
  @@map("trading_risk_events")
}

model TradingAuditLog {
  id                String   @id @default(cuid())
  userId            String
  exchangeAccountId String?
  action            String   @db.VarChar(80)
  entityType        String   @db.VarChar(50)
  entityId          String?  @db.VarChar(100)
  metadata          Json?
  ipAddress         String?  @db.VarChar(64)
  createdAt         DateTime @default(now())

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  exchangeAccount ExchangeAccount? @relation(fields: [exchangeAccountId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([exchangeAccountId, createdAt])
  @@map("trading_audit_logs")
}

model TradingOutboxEvent {
  id                BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  userId            String
  exchangeAccountId String
  provider          ExchangeProvider
  topic             String           @db.VarChar(80)
  eventType         String           @db.VarChar(80)
  aggregateType     String?          @db.VarChar(50)
  aggregateId       String?          @db.VarChar(120)
  deduplicationKey  String           @unique @db.VarChar(191)
  payload           Json
  occurredAt        DateTime
  publishedAt       DateTime?
  createdAt         DateTime         @default(now())

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  exchangeAccount ExchangeAccount @relation(fields: [exchangeAccountId], references: [id], onDelete: Cascade)

  @@index([userId, id])
  @@index([exchangeAccountId, id])
  @@index([publishedAt, id])
  @@map("trading_outbox_events")
}

model RefreshSession {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  ipAddress String?
  userAgent String?   @db.Text
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_sessions")
}
