generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  USER
}

enum UserStatus {
  ACTIVE
  PENDING
  PASSIVE
  SUSPENDED
  DELETED
}

enum UserCapabilityType {
  CREATOR
  AUTHOR
  PROJECT_OWNER
  DEVELOPER
}

enum UserCapabilityStatus {
  NOT_APPLIED
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum AuthProvider {
  GOOGLE
}

enum ExchangeProvider {
  BINANCE
  BYBIT
}

enum ExchangeEnvironment {
  TESTNET
  DEMO
}

enum ExchangeAccountType {
  USDT_M
  UNIFIED
}

enum ExchangeConnectionStatus {
  CONNECTED
  DEGRADED
  ERROR
  DISABLED
}

enum TradingExecutionEngine {
  TYPESCRIPT
  GO
}

enum TradingOrderSide {
  BUY
  SELL
}

enum TradingOrderType {
  MARKET
  LIMIT
  STOP_MARKET
  STOP_LIMIT
}

enum TradingMarginMode {
  ISOLATED
  CROSS
}

enum TradingOrderStatus {
  PENDING
  SUBMITTING
  OPEN
  PARTIALLY_FILLED
  FILLED
  CANCELING
  CANCELED
  CLOSING
  FAILED
  RECONCILIATION_REQUIRED
}

enum TradingOrderSource {
  MANUAL
  SCALPING_BOT
  GRID_BOT
  SYSTEM
  RISK_ENGINE
}

enum TradingRiskDecision {
  APPROVED
  REJECTED
  RISK_BLOCKED
  SYSTEM_BLOCKED
}

enum TradingBotType {
  SCALPING
  GRID
  AUTONOMOUS
}

enum BotCreationMethod {
  MANUAL
  CLONE
  PARAMETER_VARIANT
  CROSSOVER
}

enum TradingBotMode {
  SHADOW
  PAPER
  DEMO
}

enum TradingBotState {
  DRAFT
  VALIDATING
  STARTING
  RUNNING
  PAUSED
  STOPPED
  RISK_BLOCKED
  RECONCILING
  EMERGENCY_STOPPED
  ERROR
}

enum TradingBotDesiredState {
  RUNNING
  PAUSED
  STOPPED
}

enum TradingBotDecisionKind {
  WARMING_UP
  HOLD
  BUY
  SELL
  GRID_BUY
  GRID_SELL
  OUT_OF_RANGE
}

enum TradingBotPaperSide {
  BUY
  SELL
}

enum TradingBotSignalSource {
  RULE_ENGINE
  AI_MODEL
}

enum TradingBotSignalAction {
  HOLD
  BUY
  SELL
}

enum TradingBotSignalStatus {
  OBSERVED
  ACCEPTED
  REJECTED
  EXPIRED
}

enum AutonomousTradingStatus {
  DRAFT
  CANDIDATE
  TESTING
  PAPER
  REJECTED
  CHALLENGER
  CHAMPION
  LIVE_ELIGIBLE
  LIVE
  PAUSED
  ARCHIVED
}

enum StrategyFamily {
  GRID
  TREND
  SMA_CROSSOVER
  EMA_TREND
  MACD_TREND
  RSI_MEAN_REVERSION
  BOLLINGER_MEAN_REVERSION
  DONCHIAN_BREAKOUT
  ATR_BREAKOUT
  MOMENTUM
  VOLUME_SPIKE
  FUNDING_SKEW
  BASIS_ARBITRAGE
  NEWS_REACTIVE
  DCA
  AI_LIMIT
  MULTI_AGENT
  CUSTOM
}

enum GenerationStatus {
  DRAFT
  RUNNING
  EVALUATING
  COMPLETED
  FAILED
  ARCHIVED
}

enum PaperTradeStatus {
  OPEN
  CLOSED
  LIQUIDATED
  CANCELED
}

enum MarketRegime {
  TRENDING_UP
  TRENDING_DOWN
  RANGING
  BREAKOUT
  HIGH_VOLATILITY
  LOW_VOLATILITY
  CHAOTIC
  UNKNOWN
}

enum ChampionCandidateStatus {
  PENDING
  ELIGIBLE
  PROMOTED
  REJECTED
  DEMOTED
}

enum NewsIntegrationType {
  RSS
  API
}

enum NewsPublicationStatus {
  PENDING
  PUBLISHED
  ARCHIVED
  REJECTED
}

enum NewsAiStatus {
  WAITING
  PROCESSING
  READY
  REVIEW_REQUIRED
  FAILED
}

enum NewsAnalyticsEventType {
  NEWS_SUMMARY_VIEW
  NEWS_SOURCE_CLICK
  RELATED_NEWS_CLICK
  CATEGORY_CLICK
  WEB_VITAL
}

enum NewsRelationType {
  RELATED
  ACADEMY
  VIDEO
}

enum YoutubeChannelStatus {
  ACTIVE @map("active")
  PAUSED @map("paused")
}

enum VideoSource {
  ADMIN_MANUAL     @map("admin_manual")
  CREATOR_AUTO     @map("creator_auto")
  KRIPTOKEYFI_AUTO @map("kriptokeyfi_auto")
}

enum VideoStatus {
  PUBLISHED @map("published")
  HIDDEN    @map("hidden")
}

enum VideoContentType {
  LONG  @map("long")
  SHORT @map("short")
}

enum VideoReactionType {
  LIKE    @map("like")
  DISLIKE @map("dislike")
}

enum KOLPlatform {
  X
  YOUTUBE
  TELEGRAM
  DISCORD
  OTHER
}

enum KOLDataSourceType {
  VERIFIED_CAMPAIGN
  PLATFORM_API
  ADMIN_MANUAL
  INFLUENCER_REPORTED
  COMPANY_REPORTED
  ESTIMATED
  THIRD_PARTY
}

enum KOLConfidenceLevel {
  LOW
  MEDIUM
  HIGH
}

enum KOLPredictionDirection {
  BULLISH
  BEARISH
  NEUTRAL
}

enum KOLPredictionResult {
  PENDING
  CORRECT
  PARTIALLY_CORRECT
  INCORRECT
  EXPIRED
  INVALID
}

enum KOLRiskEventType {
  SCAM_PROMOTION
  RUG_PROMOTION
  MISLEADING_CLAIM
  UNDISCLOSED_AD
  DELETED_PROMOTION
  FAKE_ENGAGEMENT
  SUSPICIOUS_GROWTH
  COMMUNITY_COMPLAINT
  CONFLICT_OF_INTEREST
  OTHER
}

enum KOLRiskSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum KOLVisibility {
  INTERNAL
  PUBLIC
}

enum CompanyMemberRole {
  OWNER
  MANAGER
  ANALYST
}

enum CampaignStatus {
  DRAFT
  PLANNED
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum CampaignInfluencerStatus {
  INVITED
  ACCEPTED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum CampaignEventType {
  IMPRESSION
  CLICK
  REGISTRATION
  EMAIL_VERIFIED
  KYC
  DEPOSIT
  TRADE
  WALLET_CONNECT
  PURCHASE
  SUBSCRIPTION
  CUSTOM_CONVERSION
}

model User {
  id                        String                @id @default(cuid())
  email                     String                @unique
  passwordHash              String?
  name                      String?
  username                  String                @unique @db.VarChar(30)
  avatarUrl                 String?               @db.VarChar(500)
  bio                       String?               @db.VarChar(500)
  emailVerifiedAt           DateTime?
  termsAcceptedAt           DateTime?
  privacyAcceptedAt         DateTime?
  role                      UserRole              @default(USER)
  status                    UserStatus            @default(ACTIVE)
  mustChangePassword        Boolean               @default(false)
  profileCompleted          Boolean               @default(false)
  onboardingCompleted       Boolean               @default(false)
  lastLoginAt               DateTime?
  createdByAdminId          String?               @map("created_by_admin_id")
  notes                     String?               @db.Text
  createdAt                 DateTime              @default(now())
  updatedAt                 DateTime              @updatedAt
  refreshSessions           RefreshSession[]
  exchangeAccounts          ExchangeAccount[]
  manualOrderPreviews       ManualOrderPreview[]
  tradingOrders             TradingOrder[]
  tradingAuditLogs          TradingAuditLog[]
  tradingOutboxEvents       TradingOutboxEvent[]
  tradingRiskProfiles       TradingRiskProfile[]
  tradingRiskEvents         TradingRiskEvent[]
  tradingBots               TradingBot[]
  tradingBotDecisions       TradingBotDecision[]
  tradingBotSignals         TradingBotSignal[]
  strategies                Strategy[]             @relation("strategy_created_by")
  strategyVersions          StrategyVersion[]      @relation("strategy_version_created_by")
  generations               Generation[]           @relation("generation_created_by")
  identities                UserIdentity[]
  profileRoles              UserProfileRole[]
  capabilities              UserCapability[]
  savedNews                 NewsSavedArticle[]
  companyMemberships        CompanyMember[]
  kolProfile                KOL?                  @relation("kol_user")
  kolAuditLogs              KOLAuditLog[]         @relation("kol_audit_actor")
  addedYoutubeChannels      YoutubeChannel[]      @relation("youtube_channel_added_by")
  addedVideos               Video[]               @relation("video_added_by")
  ownedYoutubeChannel       YoutubeChannel?       @relation("youtube_channel_owner")
  creatorVideos             Video[]               @relation("video_creator")
  moderatedVideos           Video[]               @relation("video_moderated_by")
  deletedVideos             Video[]               @relation("video_deleted_by")
  warnedVideos              Video[]               @relation("video_warned_by")
  favoriteYoutubeChannels   UserFavoriteChannel[]
  youtubeScoreWeightUpdates YoutubeScoreWeight[]  @relation("youtube_score_weight_updated_by")
  videoReactions            UserVideoReaction[]
  createdByAdmin            User?                 @relation("user_created_by_admin", fields: [createdByAdminId], references: [id], onDelete: SetNull)
  adminCreatedUsers         User[]                @relation("user_created_by_admin")
  adminAuditLogs            UserAdminAuditLog[]   @relation("user_admin_audit_actor")
  subjectAuditLogs          UserAdminAuditLog[]   @relation("user_admin_audit_subject")

  @@index([createdByAdminId])
  @@map("users")
}

model UserAdminAuditLog {
  id        Int      @id @default(autoincrement())
  userId    String   @map("user_id")
  adminId   String   @map("admin_id")
  action    String   @db.VarChar(100)
  changes   Json?
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation("user_admin_audit_subject", fields: [userId], references: [id], onDelete: Restrict)
  admin     User     @relation("user_admin_audit_actor", fields: [adminId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([adminId, createdAt])
  @@map("user_admin_audit_logs")
}

model YoutubeChannel {
  id                Int                            @id @default(autoincrement())
  channelId         String                         @unique @map("channel_id") @db.VarChar(64)
  uploadsPlaylistId String                         @map("uploads_playlist_id") @db.VarChar(64)
  channelName       String?                        @map("channel_name") @db.VarChar(255)
  channelUrl        String?                        @map("channel_url") @db.VarChar(500)
  avatarUrl         String?                        @map("avatar_url") @db.VarChar(500)
  isOwnChannel      Boolean                        @default(false) @map("is_own_channel")
  status            YoutubeChannelStatus           @default(ACTIVE)
  lastSyncedAt      DateTime?                      @map("last_synced_at")
  addedById         String?                        @map("added_by")
  ownerUserId       String?                        @unique @map("owner_user_id")
  createdAt         DateTime                       @default(now()) @map("created_at")
  updatedAt         DateTime                       @updatedAt @map("updated_at")
  addedBy           User?                          @relation("youtube_channel_added_by", fields: [addedById], references: [id], onDelete: SetNull)
  owner             User?                          @relation("youtube_channel_owner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  videos            Video[]
  favoritedBy       UserFavoriteChannel[]
  metricSnapshots   YoutubeChannelMetricSnapshot[]
  score             YoutubeChannelScore?

  @@index([status])
  @@index([addedById])
  @@map("youtube_channels")
}

model YoutubeChannelMetricSnapshot {
  id                Int            @id @default(autoincrement())
  channelId         Int            @map("channel_id")
  snapshotDate      DateTime       @map("snapshot_date") @db.Date
  subscriberCount   Int?           @map("subscriber_count")
  totalViewCount    BigInt?        @map("total_view_count")
  videoCount        Int?           @map("video_count")
  avgViewsRecent    Int?           @map("avg_views_recent")
  avgLikesRecent    Int?           @map("avg_likes_recent")
  avgCommentsRecent Int?           @map("avg_comments_recent")
  uploadsLast90Days Int            @map("uploads_last_90_days")
  channel           YoutubeChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([channelId, snapshotDate])
  @@index([snapshotDate])
  @@map("youtube_channel_metrics_snapshots")
}

model YoutubeScoreWeight {
  id                Int      @id @default(autoincrement())
  reachWeight       Decimal  @default(20.00) @map("reach_weight") @db.Decimal(4, 2)
  engagementWeight  Decimal  @default(30.00) @map("engagement_weight") @db.Decimal(4, 2)
  viewPowerWeight   Decimal  @default(25.00) @map("view_power_weight") @db.Decimal(4, 2)
  consistencyWeight Decimal  @default(15.00) @map("consistency_weight") @db.Decimal(4, 2)
  growthWeight      Decimal  @default(10.00) @map("growth_weight") @db.Decimal(4, 2)
  updatedAt         DateTime @updatedAt @map("updated_at")
  updatedById       String?  @map("updated_by")
  updatedBy         User?    @relation("youtube_score_weight_updated_by", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([updatedById])
  @@map("youtube_score_weights")
}

model YoutubeChannelScore {
  id               Int            @id @default(autoincrement())
  channelId        Int            @unique @map("channel_id")
  totalScore       Decimal?       @map("total_score") @db.Decimal(5, 2)
  reachScore       Decimal?       @map("reach_score") @db.Decimal(5, 2)
  engagementScore  Decimal?       @map("engagement_score") @db.Decimal(5, 2)
  viewPowerScore   Decimal?       @map("view_power_score") @db.Decimal(5, 2)
  consistencyScore Decimal?       @map("consistency_score") @db.Decimal(5, 2)
  growthScore      Decimal?       @map("growth_score") @db.Decimal(5, 2)
  calculatedAt     DateTime       @default(now()) @map("calculated_at")
  channel          YoutubeChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@map("youtube_channel_scores")
}

model UserFavoriteChannel {
  id        Int            @id @default(autoincrement())
  userId    String         @map("user_id")
  channelId Int            @map("channel_id")
  createdAt DateTime       @default(now()) @map("created_at")
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel   YoutubeChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([userId, channelId])
  @@index([channelId])
  @@map("user_favorite_channels")
}

model UserVideoReaction {
  id        Int               @id @default(autoincrement())
  userId    String            @map("user_id")
  videoId   Int               @map("video_id")
  reaction  VideoReactionType
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  video     Video             @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([userId, videoId])
  @@index([videoId, reaction])
  @@map("user_video_reactions")
}

model Video {
  id                    Int                 @id @default(autoincrement())
  youtubeVideoId        String              @unique @map("youtube_video_id") @db.VarChar(32)
  youtubeUrl            String              @map("youtube_url") @db.VarChar(500)
  channelId             Int?                @map("channel_id")
  channelName           String?             @map("channel_name") @db.VarChar(255)
  title                 String?             @db.VarChar(500)
  description           String?             @db.Text
  thumbnailUrl          String?             @map("thumbnail_url") @db.VarChar(500)
  duration              String?             @db.VarChar(16)
  durationSeconds       Int?                @map("duration_seconds")
  contentType           VideoContentType    @default(LONG) @map("content_type")
  publishedAt           DateTime?           @map("published_at")
  source                VideoSource
  status                VideoStatus         @default(PUBLISHED)
  addedById             String?             @map("added_by")
  creatorId             String?             @map("creator_id")
  deletedAt             DateTime?           @map("deleted_at")
  deletedById           String?             @map("deleted_by")
  titleOverride         String?             @map("title_override") @db.VarChar(500)
  descriptionOverride   String?             @map("description_override") @db.Text
  warningLabel          String?             @map("warning_label") @db.VarChar(50)
  warningNote           String?             @map("warning_note") @db.Text
  warningVisibleToUsers Boolean             @default(false) @map("warning_visible_to_users")
  warnedById            String?             @map("warned_by")
  warnedAt              DateTime?           @map("warned_at")
  moderatedById         String?             @map("moderated_by")
  moderatedAt           DateTime?           @map("moderated_at")
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")
  channel               YoutubeChannel?     @relation(fields: [channelId], references: [id], onDelete: SetNull)
  addedBy               User?               @relation("video_added_by", fields: [addedById], references: [id], onDelete: SetNull)
  creator               User?               @relation("video_creator", fields: [creatorId], references: [id], onDelete: SetNull)
  deletedBy             User?               @relation("video_deleted_by", fields: [deletedById], references: [id], onDelete: SetNull)
  warnedBy              User?               @relation("video_warned_by", fields: [warnedById], references: [id], onDelete: SetNull)
  moderatedBy           User?               @relation("video_moderated_by", fields: [moderatedById], references: [id], onDelete: SetNull)
  reactions             UserVideoReaction[]

  @@index([channelId])
  @@index([status, publishedAt])
  @@index([status, contentType, publishedAt])
  @@index([source, status])
  @@index([addedById])
  @@index([creatorId])
  @@index([deletedAt])
  @@index([deletedById])
  @@index([warnedById])
  @@index([moderatedById])
  @@map("videos")
}

model KOL {
  id                  String               @id @default(cuid())
  userId              String?              @unique
  slug                String               @unique @db.VarChar(100)
  displayName         String               @db.VarChar(160)
  username            String               @db.VarChar(100)
  avatarUrl           String?              @db.VarChar(700)
  country             String               @db.VarChar(80)
  language            String               @db.VarChar(16)
  bio                 String?              @db.Text
  isVerified          Boolean              @default(false)
  isDemo              Boolean              @default(false)
  isPublished         Boolean              @default(false)
  categories          Json
  useCaseScores       Json?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  user                User?                @relation("kol_user", fields: [userId], references: [id], onDelete: SetNull)
  socialAccounts      KOLSocialAccount[]
  scores              KOLScore[]
  predictions         KOLPrediction[]
  riskEvents          KOLRiskEvent[]
  audienceMetrics     KOLAudienceMetric[]
  campaignInfluencers CampaignInfluencer[]

  @@index([isPublished, isVerified])
  @@index([country, language])
  @@map("kols")
}

model KOLSocialAccount {
  id                String             @id @default(cuid())
  kolId             String
  platform          KOLPlatform
  platformUserId    String?            @db.VarChar(64)
  handle            String             @db.VarChar(160)
  profileUrl        String?            @db.VarChar(700)
  followerCount     BigInt             @default(0)
  followingCount    BigInt             @default(0)
  contentCount      BigInt             @default(0)
  listedCount       BigInt             @default(0)
  platformVerified  Boolean            @default(false)
  platformCreatedAt DateTime?
  engagementRate    Decimal?           @db.Decimal(8, 4)
  accountAgeDays    Int?
  sourceType        KOLDataSourceType
  verified          Boolean            @default(false)
  verificationDate  DateTime?
  confidence        KOLConfidenceLevel @default(LOW)
  sourceReference   String?            @db.VarChar(700)
  measuredAt        DateTime
  kol               KOL                @relation(fields: [kolId], references: [id], onDelete: Cascade)

  @@unique([kolId, platform, handle])
  @@unique([platform, platformUserId])
  @@index([platform, followerCount])
  @@map("kol_social_accounts")
}

model KOLScore {
  id                  String             @id @default(cuid())
  kolId               String
  overall             Decimal            @db.Decimal(5, 2)
  trust               Decimal            @db.Decimal(5, 2)
  audienceQuality     Decimal            @db.Decimal(5, 2)
  engagementQuality   Decimal            @db.Decimal(5, 2)
  marketKnowledge     Decimal            @db.Decimal(5, 2)
  predictionAccuracy  Decimal            @db.Decimal(5, 2)
  campaignPerformance Decimal            @db.Decimal(5, 2)
  transparency        Decimal            @db.Decimal(5, 2)
  risk                Decimal            @db.Decimal(5, 2)
  confidence          KOLConfidenceLevel
  sampleSize          Int                @default(0)
  verifiedDataRatio   Decimal            @db.Decimal(5, 4)
  methodologyVersion  String             @db.VarChar(40)
  calculatedAt        DateTime           @default(now())
  kol                 KOL                @relation(fields: [kolId], references: [id], onDelete: Cascade)

  @@index([kolId, calculatedAt])
  @@index([overall, confidence])
  @@map("kol_scores")
}

model KOLPrediction {
  id                String                 @id @default(cuid())
  kolId             String
  assetSymbol       String                 @db.VarChar(30)
  platform          KOLPlatform
  sourceUrl         String                 @db.VarChar(700)
  sourceContent     String                 @db.Text
  sourceContentHash String?                @db.VarChar(64)
  sourceSnapshotRef String?                @db.VarChar(700)
  publishedAt       DateTime
  capturedAt        DateTime               @default(now())
  direction         KOLPredictionDirection
  referencePrice    Decimal                @db.Decimal(36, 18)
  targetPrice       Decimal?               @db.Decimal(36, 18)
  invalidationPrice Decimal?               @db.Decimal(36, 18)
  timeHorizonDays   Int
  confidence        Decimal?               @db.Decimal(5, 2)
  evaluationDate    DateTime?
  result            KOLPredictionResult    @default(PENDING)
  evaluationNotes   String?                @db.Text
  evaluatedByUserId String?
  kol               KOL                    @relation(fields: [kolId], references: [id], onDelete: Cascade)

  @@index([kolId, publishedAt])
  @@index([result, evaluationDate])
  @@map("kol_predictions")
}

model KOLRiskEvent {
  id          String           @id @default(cuid())
  kolId       String
  type        KOLRiskEventType
  severity    KOLRiskSeverity
  title       String           @db.VarChar(220)
  description String           @db.Text
  evidenceUrl String?          @db.VarChar(700)
  verified    Boolean          @default(false)
  visibility  KOLVisibility    @default(INTERNAL)
  occurredAt  DateTime
  adminNotes  String?          @db.Text
  createdAt   DateTime         @default(now())
  kol         KOL              @relation(fields: [kolId], references: [id], onDelete: Cascade)

  @@index([kolId, visibility, occurredAt])
  @@index([type, severity])
  @@map("kol_risk_events")
}

model KOLAudienceMetric {
  id                     String             @id @default(cuid())
  kolId                  String
  platform               KOLPlatform
  totalFollowers         BigInt
  estimatedRealAudience  BigInt?
  estimatedBotPercentage Decimal?           @db.Decimal(5, 2)
  engagementRate         Decimal?           @db.Decimal(8, 4)
  averageViews           BigInt?
  averageComments        Int?
  averageShares          Int?
  averageLikes           Int?
  suspiciousGrowth       Boolean            @default(false)
  distribution           Json?
  sourceType             KOLDataSourceType
  verified               Boolean            @default(false)
  confidence             KOLConfidenceLevel @default(LOW)
  sourceReference        String?            @db.VarChar(700)
  measuredAt             DateTime
  kol                    KOL                @relation(fields: [kolId], references: [id], onDelete: Cascade)

  @@index([kolId, platform, measuredAt])
  @@map("kol_audience_metrics")
}

model Company {
  id        String          @id @default(cuid())
  name      String          @db.VarChar(180)
  website   String?         @db.VarChar(500)
  sector    String?         @db.VarChar(100)
  country   String          @db.VarChar(80)
  verified  Boolean         @default(false)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  members   CompanyMember[]
  campaigns Campaign[]

  @@map("companies")
}

model CompanyMember {
  companyId String
  userId    String
  role      CompanyMemberRole @default(ANALYST)
  company   Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([companyId, userId])
  @@index([userId])
  @@map("company_members")
}

model Campaign {
  id               String                 @id @default(cuid())
  companyId        String
  name             String                 @db.VarChar(180)
  project          String                 @db.VarChar(180)
  description      String?                @db.Text
  goal             String                 @db.VarChar(80)
  budget           Decimal                @db.Decimal(18, 2)
  currency         String                 @db.VarChar(12)
  countryTargets   Json
  languageTargets  Json
  audienceTargets  Json?
