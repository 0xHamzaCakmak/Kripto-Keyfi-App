# Shadow mode is mandatory until the manual-order cutover acceptance criteria pass.
TRADING_ENGINE_MODE=shadow
TRADING_ENGINE_ADDR=:8081
TRADING_ENGINE_TOKEN=
TRADING_ENGINE_SHADOW_READ_ENABLED=false
TRADING_ENGINE_REALTIME_ENABLED=false
TRADING_ENGINE_BOT_SCHEDULER_ENABLED=false
TRADING_ENGINE_AUTONOMOUS_TESTNET_ENABLED=false
TRADING_ENGINE_LIQUIDATION_STREAM_ENABLED=false
TRADING_ENGINE_LIQUIDATION_STREAM_URL=wss://fstream.binance.com/ws/!forceOrder@arr
# Comparison-only AI observer. Keep disabled until an approved inference gateway is configured.
TRADING_ENGINE_AI_OBSERVER_ENABLED=false
TRADING_ENGINE_AI_OBSERVER_URL=
TRADING_ENGINE_AI_OBSERVER_TOKEN=
TRADING_ENGINE_AI_OBSERVER_PROVIDER=HTTP_GATEWAY
TRADING_ENGINE_AI_OBSERVER_MODEL=
TRADING_ENGINE_AI_OBSERVER_PROMPT_VERSION=v1
TRADING_ENGINE_AI_OBSERVER_TIMEOUT=1500ms
TRADING_ENGINE_LOG_LEVEL=info
TRADING_ENGINE_SHUTDOWN_TIMEOUT=10s

# DATABASE_URL is required for the public-market SHADOW/PAPER bot scheduler.
# The master key is required only for private shadow reads/realtime/cutover.
DATABASE_URL=mysql://root:root@127.0.0.1:3306/kriptokeyfi
TRADING_CREDENTIALS_MASTER_KEY=

# Set only during the controlled per-account executor cutover.
# TRADING_ENGINE_MODE=cutover
